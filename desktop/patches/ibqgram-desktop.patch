diff --git a/Telegram/SourceFiles/window/notifications_icqram.cpp b/Telegram/SourceFiles/window/notifications_icqram.cpp
new file mode 100644
index 0000000000..02e2ee8b78
--- /dev/null
+++ b/Telegram/SourceFiles/window/notifications_icqram.cpp
@@ -0,0 +1,82 @@
+#include "window/notifications_icqram.h"
+
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "data/data_channel.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "main/main_session.h"
+#include "window/notifications_manager.h"
+#include "window/window_icqram_shell.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QFile>
+#include <QtCore/QSettings>
+
+namespace Window::Notifications {
+
+QJsonObject IcqramPreferences() {
+	const auto &settings = Core::App().settings();
+	auto local = QSettings(u"icqram"_q, u"icqram"_q);
+	auto result = QJsonObject{
+		{ u"enabled"_q, settings.desktopNotify() },
+		{ u"sound"_q, settings.soundNotify() },
+		{ u"preview"_q, int(settings.notifyView()) },
+	};
+	for (const auto key : { u"private"_q, u"groups"_q, u"channels"_q, u"pauseInDnd"_q }) {
+		result.insert(key, local.value(u"notifications/"_q + key, true).toBool());
+	}
+	return result;
+}
+
+bool SaveIcqramPreferences(const QJsonObject &values) {
+	const auto current = IcqramPreferences();
+	for (auto i = values.begin(); i != values.end(); ++i) {
+		if (!current.contains(i.key())) return false;
+		if (i.key() == u"preview"_q) {
+			if (!i.value().isDouble() || i.value().toDouble() != i.value().toInt(-1)
+				|| i.value().toInt(-1) < 0 || i.value().toInt(-1) > 2) return false;
+		} else if (!i.value().isBool()) {
+			return false;
+		}
+	}
+	auto local = QSettings(u"icqram"_q, u"icqram"_q);
+	for (const auto key : { u"private"_q, u"groups"_q, u"channels"_q, u"pauseInDnd"_q }) {
+		if (values.contains(key)) local.setValue(u"notifications/"_q + key, values.value(key).toBool());
+	}
+	local.sync();
+	if (local.status() != QSettings::NoError) return false;
+	auto &settings = Core::App().settings();
+	if (values.contains(u"enabled"_q)) settings.setDesktopNotify(values.value(u"enabled"_q).toBool());
+	if (values.contains(u"sound"_q)) settings.setSoundNotify(values.value(u"sound"_q).toBool());
+	if (values.contains(u"preview"_q)) settings.setNotifyView(Core::Settings::NotifyView(values.value(u"preview"_q).toInt()));
+	settings.setNativeNotifications(true);
+	Core::App().saveSettingsDelayed();
+	Core::App().notifications().clearAll();
+	Core::App().notifications().notifySettingsChanged(ChangeType::ViewParams);
+	Core::App().notifications().notifySettingsChanged(ChangeType::DesktopEnabled);
+	return true;
+}
+
+bool IcqramAllowsNotification(not_null<HistoryItem*> item) {
+	const auto preferences = IcqramPreferences();
+	if (!preferences.value(u"enabled"_q).toBool()) return false;
+	const auto peer = item->history()->peer;
+	const auto channel = peer->asChannel();
+	const auto category = peer->isUser() ? u"private"_q
+		: (channel && channel->isBroadcast()) ? u"channels"_q : u"groups"_q;
+	if (!preferences.value(category).toBool()) return false;
+	const auto &session = item->history()->session();
+	const auto status = QSettings(u"icqram"_q, u"icqram"_q).value(
+		u"accounts/"_q + QString::number(session.userId().bare) + u"/presence"_q).toString();
+	if (preferences.value(u"pauseInDnd"_q).toBool() && status == u"DND"_q) return false;
+	return !IcqramShell::IsReadingChat(&session.account(), peer->id, item->topicRootId());
+}
+
+QString IcqramSoundPath() {
+	const auto path = QCoreApplication::applicationDirPath()
+		+ u"/../Resources/ui/sounds/icq-message-received-sfx.mp3"_q;
+	return QFile::exists(path) ? path : QString();
+}
+
+}
