+bool IsAuxiliary(const QString &kind) {
+	return kind == u"profile"_q || kind == u"settings"_q || kind == u"about"_q
+		|| kind == u"commands"_q || kind == u"presence"_q || kind == u"info"_q || kind == u"now"_q;
+}
+}
+
+IcqramShell::IcqramShell(QWidget *parent, not_null<Main::Account*> account, not_null<Controller*> controller, QString peerId, int mediaId, Api::IcqramChat *mediaApi, QJsonObject panelData)
+: RpWidget(parent)
+, _account(account)
+, _controller(controller)
+, _peerId(std::move(peerId))
+, _mediaId(mediaId)
+, _mediaApi(mediaApi) {
+	if (!account->sessionExists()) {
+		_authData.reset(new Intro::details::Data{ .controller = controller });
+		_auth = std::make_unique<Intro::IcqramAuth>(this, account, _authData.get());
+	}
+	_accountApi = std::make_unique<Api::IcqramAccount>(account, [=] {
+		return !_locked && !Core::App().passcodeLocked() && _account->sessionExists();
+	});
+#ifdef Q_OS_MAC
+	const auto origin = QUrl::fromLocalFile(
+		QDir::cleanPath(QCoreApplication::applicationDirPath()
+			+ u"/../Resources/ui"_q) + '/').toString();
+#else
+	const auto origin = u"icqram-ui://domain/"_q;
+#endif
+	setWindowFlags(Qt::Window | Qt::FramelessWindowHint);
+	setAttribute(Qt::WA_TranslucentBackground);
+	setWindowTitle(_peerId == u"profile"_q ? u"IBQgram — Account details"_q : _mediaId ? u"IBQgram — Medya görüntüleyici"_q : _peerId.isEmpty() ? u"IBQgram"_q : _peerId == u"directory"_q ? u"IBQgram — User Directory"_q : u"IBQgram — Sohbet"_q);
+	if (IsAuxiliary(_peerId)) setWindowTitle(u"IBQgram — "_q + (_peerId == u"now"_q ? u"ICQ Now!"_q : _peerId));
+	QApplication::setQuitOnLastWindowClosed(false);
+	if (_mediaId) setFixedSize(640, 520);
+	else if (_peerId.isEmpty()) { setMinimumSize(236, 300); setMaximumSize(900, 1000); const auto saved = QSettings(u"icqram"_q, u"icqram"_q).value(u"windows/contactsSize"_q).toSize();
+		resize(account->sessionExists() && saved.isValid() ? saved.boundedTo(QSize(900, 1000)).expandedTo(QSize(236, 300)) : QSize(320, 370)); }
+	else if (_peerId == u"now"_q) { setMinimumSize(500, 400); setMaximumSize(1400, 1100); resize(820, 740); }
+	else if (_peerId == u"profile"_q) { setFixedSize(320, 340); }
+	else if (_peerId == u"commands"_q) { setFixedSize(400, 350); }
+	else if (_peerId == u"settings"_q) { setFixedSize(400, 560); }
+	else if (_peerId == u"about"_q) { setFixedSize(350, 280); }
+	else if (_peerId == u"presence"_q) { setFixedSize(350, 400); }
+	else if (_peerId == u"info"_q) { setMinimumSize(320, 200); resize(360, 280); }
+	else if (_peerId == u"directory"_q) { setMinimumSize(456, 437); setMaximumSize(1000, 900); resize(456, 437); }
+	else { setMinimumSize(476, 267); setMaximumSize(1200, 900); resize(600, 440); }
+	if (const auto screen = QGuiApplication::primaryScreen()) {
+		move(screen->availableGeometry().center() - rect().center());
+	}
+	_webview = std::make_unique<Webview::Window>(this, Webview::WindowConfig{
+		.opaqueBg = QColor(0, 0, 0, 0),
+		.storageId = {
+			.token = QByteArray::fromHex("7b06519d4a8d44d9bca6923931175aa2"),
+		},
+		.dataProtocolOverride = u"icqram-ui"_q,
+#ifdef Q_OS_MAC
+		.localContentDirectory = QUrl(origin).toLocalFile(),
+#endif
+	});
+	if (!_webview->valid()) {
+		const auto error = new QLabel(
+			u"IBQgram başlatılamadı. Uygulamayı yeniden açmayı dene."_q,
+			this);
+		error->setAlignment(Qt::AlignCenter);
+		sizeValue() | rpl::on_next([=](QSize size) {
+			error->setGeometry(QRect(QPoint(), size));
+		}, lifetime());
+		return;
+	}
+	_webview->setPermissionHandler([](
+			Webview::PermissionType,
+			std::function<void(bool)> done) {
+		done(false);
+	});
+	_webview->setNavigationPolicyHandler([=](QString url, bool newWindow) {
+		const auto allowed = !newWindow
+			&& (url == origin + u"index.html"_q
+				|| url == origin + u"brand.html"_q
+				|| (_peerId == u"now"_q && (url == origin + u"now.html"_q || url == u"about:blank"_q)));
+		LOG(("icqram local navigation: allowed=%1, local=%2").arg(allowed).arg(url.startsWith(u"file:"_q)));
+		return allowed;
+	});
+	_webview->setNavigationDoneHandler([](bool success) {
+		LOG(("icqram local document loaded: %1").arg(success));
+	});
+	_webview->setDataRequestHandler([=](Webview::DataRequest request) {
+		if (request.id == "media/playback") {
+			if (!_mediaId || !_mediaApi || _locked || Core::App().passcodeLocked()
+				|| !_account->sessionExists() || !isVisible()) return Webview::DataResult::Failed;
+			auto chunk = _mediaApi->mediaChunk(_mediaId, request.offset, request.limit);
+			if (chunk.bytes.isEmpty()) return Webview::DataResult::Failed;
+			request.done({
+				.stream = std::make_unique<Webview::DataStreamFromMemory>(std::move(chunk.bytes), chunk.mime.toStdString()),
+				.streamOffset = request.offset,
+				.totalSize = chunk.total,
+			});
+			return Webview::DataResult::Done;
+		}
+		const auto id = QString::fromStdString(request.id).section('?', 0, 0);
+		if (id.isEmpty()
+			|| id.contains(u".."_q)
+			|| id.contains('%')
+			|| id.contains('\\')
+			|| id.startsWith('/')) {
+			return Webview::DataResult::Failed;
+		}
+		auto file = QFile(u":/icqram/"_q + id);
+		if (!file.open(QIODevice::ReadOnly)) {
+			return Webview::DataResult::Failed;
+		}
+		auto data = file.readAll();
+		const auto size = data.size();
+		if (size <= 0 || request.offset < 0 || request.offset >= size) {
+			return Webview::DataResult::Failed;
+		}
+		const auto mime = QMimeDatabase().mimeTypeForFile(id).name();
+		request.done({
+			.stream = std::make_unique<Webview::DataStreamFromMemory>(
+				std::move(data),
+				mime.toStdString()),
+			.totalSize = size,
+		});
+		return Webview::DataResult::Done;
+	});
+	#ifdef Q_OS_MAC
+	if (_peerId.isEmpty() && !_mediaId) {
+		_startupActive = Platform::ShowIcqramStartup(QUrl(origin).toLocalFile());
+		_startupDeadline.setCallback([=] { finishStartup(); });
+		if (_startupActive) _startupDeadline.callOnce(6500);
+	}
+#endif
+	const auto context = QJsonDocument(QJsonObject{
+		{u"nativeStartup"_q, _startupActive},
+		{u"notifications"_q, Notifications::IcqramPreferences()},
+		{u"panelData"_q, panelData}, {u"localPresence"_q, LocalPresence()},
+		{u"contactsSize"_q, [&] {
+			const auto size = QSettings(u"icqram"_q, u"icqram"_q).value(u"windows/contactsSize"_q).toSize();
+			return size.isValid() ? QJsonObject{{u"width"_q, size.width()}, {u"height"_q, size.height()}} : QJsonObject();
+		}()},
+		{u"kind"_q, _mediaId ? u"viewer"_q : IsAuxiliary(_peerId) ? _peerId : _peerId == u"directory"_q ? u"directory"_q : !_peerId.isEmpty() ? u"chat"_q : account->sessionExists() ? u"contacts"_q : u"login"_q},
+		{u"fixtures"_q, false}, {u"contactId"_q, _peerId}, {u"messageId"_q, _mediaId},
+		{u"ownUin"_q, account->sessionExists() ? QString::number(account->session().userId().bare) : QString()}
+	}).toJson(QJsonDocument::Compact);
+	_webview->init("Object.defineProperty(window,'icqramView',{value:Object.freeze(" + context + ")});" + QByteArray(R"JS(
+Object.defineProperty(window, 'icqramHost', { value: Object.freeze({
+ postMessage: value => window.external.invoke(value)
+}) });
+)JS"));
+	if (!_mediaId && !_peerId.isEmpty() && _peerId != u"directory"_q && !IsAuxiliary(_peerId)) {
+		_chatApi = std::make_unique<Api::IcqramChat>(account, _peerId, [=] {
+			return !_locked && !Core::App().passcodeLocked() && _account->sessionExists();
+		}, [=] {
+			if (isVisible()) _webview->eval("window.dispatchEvent(new Event('icqram-chat-changed'));");
+		});
+	}
+	_webview->setMessageHandler([=](Webview::Message message) {
+		if (QString::fromStdString(message.sourceUrl) != origin + (_peerId == u"now"_q ? u"now.html"_q : u"index.html"_q)
+			|| message.text.size() > 65536) {
+			return;
+		}
+		const auto body = QJsonDocument::fromJson(
+			QByteArray::fromStdString(message.text)).object();
+		const auto id = body.value(u"id"_q).toInteger();
+		if (body.value(u"version"_q).toInt() != 1 || id <= 0) {
+			return;
+		}
+		auto reply = QJsonObject{
+			{ u"version"_q, 1 },
+			{ u"id"_q, id },
+		};
+		const auto method = body.value(u"method"_q).toString();
+		const auto params = body.value(u"params"_q).toObject();
+		if (_peerId == u"now"_q && method != u"window.close"_q && method != u"window.minimize"_q
+			&& method != u"window.resize"_q && method != u"window.dragStart"_q
+			&& method != u"window.dragMove"_q && method != u"window.dragEnd"_q) {
+			return sendReply(id, {}, u"UNSUPPORTED_METHOD"_q);
+		}
+		if ((_locked || Core::App().passcodeLocked()) && method != u"window.close"_q) {
+			return sendReply(id, {}, u"LOCKED"_q);
+		}
+		if (method == u"window.openCommands"_q && _chatApi && !_mediaId && _account->sessionExists()) {
+			const auto peer = _account->session().data().peerLoaded(Api::IcqramPeerId(_peerId));
+			if (!peer || !peer->isBot()) return sendReply(id, {}, u"INVALID_REQUEST"_q);
+			const auto query = params.value(u"query"_q).toString().left(64);
+			InvokeQueued(this, [=] {
+				if (_locked || Core::App().passcodeLocked() || !_account->sessionExists()) return;
+				auto &commands = _chats[u"commands"_q];
+				const auto data = QJsonObject{{u"query"_q, query}, {u"name"_q, peer->name()}};
+				if (!commands) commands = std::make_unique<IcqramShell>(nullptr, _account, _controller, u"commands"_q, 0, nullptr, data);
+				commands->_commandOwner = this;
+				commands->_commandTopic = _chatApi->currentTopicId();
+				commands->focus();
+				commands->_webview->eval("window.dispatchEvent(new CustomEvent('icqram-commands-open',{detail:"
+					+ QJsonDocument(data).toJson(QJsonDocument::Compact) + "}));");
+			});
+			return sendReply(id, {{u"ok"_q, true}});
+		}
+		if (_peerId == u"commands"_q && method.startsWith(u"commands."_q)) {
+			const auto owner = _commandOwner.data();
+			if (!owner || owner->_locked || !owner->_chatApi || !_account->sessionExists()) return sendReply(id, {}, u"LOCKED"_q);
+			if (method != u"commands.load"_q && method != u"commands.refresh"_q && method != u"commands.select"_q) return sendReply(id, {}, u"INVALID_REQUEST"_q);
+			owner->_chatApi->request(method == u"commands.refresh"_q ? u"chat.commands.refresh"_q : u"chat.state"_q, {},
+				crl::guard(this, [=](QJsonObject state, QString error) {
+					if (!error.isEmpty()) return sendReply(id, {}, error);
+					if (method != u"commands.select"_q) return sendReply(id, state);
+					if (!isVisible() || !state.value(u"canSend"_q).toBool() || state.value(u"blocked"_q).toBool()) return sendReply(id, {}, u"CHAT_READ_ONLY"_q);
+					if (owner->_chatApi->currentTopicId() != _commandTopic) return sendReply(id, {}, u"TOPIC_CHANGED"_q);
+					const auto command = params.value(u"command"_q).toString();
+					auto found = false;
+					for (const auto item : state.value(u"commands"_q).toArray()) {
+						if (item.toObject().value(u"command"_q).toString() == command) found = true;
+					}
+					if (!found) return sendReply(id, {}, u"INVALID_REQUEST"_q);
+					const auto data = QJsonDocument(QJsonObject{{u"command"_q, command}, {u"topicId"_q, _commandTopic}}).toJson(QJsonDocument::Compact);
+					sendReply(id, {{u"ok"_q, true}});
+					hide();
+					owner->focus();
+					owner->_webview->eval("window.dispatchEvent(new CustomEvent('icqram-command-selected',{detail:" + data + "}));");
+				}));
+			return;
+		}
+		if (method.startsWith(u"notifications."_q) && _account->sessionExists()) {
+			if (method == u"notifications.save"_q) {
+				if (!Notifications::SaveIcqramPreferences(params)) return sendReply(id, {}, u"INVALID_REQUEST"_q);
+				const auto state = Notifications::IcqramPreferences();
+				const auto data = QJsonDocument(state).toJson(QJsonDocument::Compact);
+				for (const auto widget : QApplication::topLevelWidgets()) {
+					const auto shell = dynamic_cast<IcqramShell*>(widget);
+					if (shell && shell->_webview && shell->_peerId != u"now"_q) {
+						shell->_webview->eval("window.dispatchEvent(new CustomEvent('icqram-notifications',{detail:" + data + "}));");
+					}
+				}
+				return sendReply(id, state);
+			}
+#ifdef Q_OS_MAC
+			if (method == u"notifications.load"_q || method == u"notifications.authorize"_q) {
+				Platform::Notifications::IcqramAuthorization(method == u"notifications.authorize"_q,
+					crl::guard(this, [=](QJsonObject result) {
+						auto state = Notifications::IcqramPreferences();
+						state.insert(u"system"_q, result);
+						sendReply(id, state);
+					}));
+				return;
+			} else if (method == u"notifications.test"_q && _peerId == u"settings"_q) {
+				Platform::Notifications::IcqramTestNotification(crl::guard(this, [=](QString error) {
+					sendReply(id, {{u"ok"_q, error.isEmpty()}}, error);
+				}));
+				return;
+			} else if (method == u"notifications.systemSettings"_q && _peerId == u"settings"_q) {
+				Platform::Notifications::IcqramOpenNotificationSettings();
+				return sendReply(id, {{u"ok"_q, true}});
+			}
+#endif
+			return sendReply(id, {}, u"UNSUPPORTED_METHOD"_q);
+		}
+		if (method == u"startup.finish"_q && _peerId.isEmpty()) {
+			InvokeQueued(this, [=] { finishStartup(); });
+			return sendReply(id, {{u"ok"_q, true}});
+		} else if (method == u"window.openPanel"_q) {
+			const auto kind = params.value(u"kind"_q).toString();
+			if (!IsAuxiliary(kind) || kind == u"commands"_q) return sendReply(id, {}, u"INVALID_REQUEST"_q);
+			if ((kind == u"presence"_q || kind == u"profile"_q) && !_account->sessionExists()) return sendReply(id, {}, u"LOCKED"_q);
+			auto data = QJsonObject();
+			if (kind == u"info"_q) {
+				const auto title = params.value(u"title"_q).toString();
+				const auto lines = params.value(u"lines"_q).toArray();
+				if (title.size() > 120 || lines.size() > 16) return sendReply(id, {}, u"INVALID_REQUEST"_q);
+				for (const auto line : lines) if (!line.isString() || line.toString().size() > 2000) return sendReply(id, {}, u"INVALID_REQUEST"_q);
+				data = {{u"title"_q, title}, {u"lines"_q, lines}};
