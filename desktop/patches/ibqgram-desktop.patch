diff --git a/Telegram/cmake/icqram.cmake b/Telegram/cmake/icqram.cmake
new file mode 100644
index 0000000000..7ba24e85ec
--- /dev/null
+++ b/Telegram/cmake/icqram.cmake
@@ -0,0 +1,38 @@
+option(ICQRAM_SHELL "Use the shared icqram HTML shell." OFF)
+set(ICQRAM_UI_QRC "" CACHE FILEPATH "Generated resource collection for the shared UI.")
+set(ICQRAM_ICON_ICNS "" CACHE FILEPATH "Flower application icon.")
+if (ICQRAM_SHELL)
+    if (NOT EXISTS "${ICQRAM_UI_QRC}")
+        message(FATAL_ERROR "Generate ICQRAM_UI_QRC with the icqram root build script first.")
+    endif()
+    if (NOT EXISTS "${ICQRAM_ICON_ICNS}")
+        message(FATAL_ERROR "Generate ICQRAM_ICON_ICNS with the icqram root build script first.")
+    endif()
+    set_source_files_properties("${ICQRAM_ICON_ICNS}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
+    target_sources(Telegram PRIVATE "${ICQRAM_ICON_ICNS}")
+    if (APPLE)
+        get_filename_component(icqram_ui_parent "${ICQRAM_UI_QRC}" DIRECTORY)
+        set(icqram_ui_dir "${icqram_ui_parent}/ui")
+        file(GLOB_RECURSE icqram_ui_files CONFIGURE_DEPENDS "${icqram_ui_dir}/*")
+        foreach(icqram_ui_file IN LISTS icqram_ui_files)
+            file(RELATIVE_PATH icqram_ui_relative "${icqram_ui_dir}" "${icqram_ui_file}")
+            get_filename_component(icqram_ui_folder "${icqram_ui_relative}" DIRECTORY)
+            set_source_files_properties("${icqram_ui_file}" PROPERTIES MACOSX_PACKAGE_LOCATION "Resources/ui/${icqram_ui_folder}")
+        endforeach()
+        target_sources(Telegram PRIVATE ${icqram_ui_files})
+    endif()
+    target_compile_definitions(Telegram PRIVATE ICQRAM_SHELL)
+    target_sources(Telegram PRIVATE
+        SourceFiles/window/window_icqram_shell.cpp
+        SourceFiles/window/window_icqram_shell.h
+        SourceFiles/window/notifications_icqram.cpp
+        SourceFiles/window/notifications_icqram.h
+        SourceFiles/intro/intro_icqram_auth.cpp
+        SourceFiles/intro/intro_icqram_auth.h
+        SourceFiles/api/api_icqram_account.cpp
+        SourceFiles/api/api_icqram_account.h
+        SourceFiles/api/api_icqram_chat.cpp
+        SourceFiles/api/api_icqram_chat.h
+        "${ICQRAM_UI_QRC}"
+    )
+endif()
diff --git a/Telegram/cmake/icqram_apple_runtime.cmake b/Telegram/cmake/icqram_apple_runtime.cmake
new file mode 100644
index 0000000000..d2de0ae9f2
--- /dev/null
+++ b/Telegram/cmake/icqram_apple_runtime.cmake
@@ -0,0 +1,46 @@
+# Keep the icqram arm64 bundle free of Intel-only Swift back-deployment libraries.
+if (NOT DEFINED ICQRAM_EXECUTABLE OR NOT EXISTS "${ICQRAM_EXECUTABLE}")
+    message(FATAL_ERROR "An existing icqram executable is required.")
+endif()
+find_program(icqram_lipo lipo REQUIRED)
+find_program(icqram_otool otool REQUIRED)
+execute_process(COMMAND "${icqram_lipo}" -archs "${ICQRAM_EXECUTABLE}"
+    OUTPUT_VARIABLE icqram_archs OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
+if (NOT icqram_archs STREQUAL "arm64")
+    return()
+endif()
+get_filename_component(icqram_bin_dir "${ICQRAM_EXECUTABLE}" DIRECTORY)
+set(icqram_frameworks "${icqram_bin_dir}/../Frameworks")
+file(GLOB icqram_libraries "${icqram_frameworks}/libswift*.dylib")
+set(icqram_arm_libraries "${ICQRAM_EXECUTABLE}")
+set(icqram_incompatible)
+foreach(icqram_library IN LISTS icqram_libraries)
+    execute_process(COMMAND "${icqram_lipo}" -archs "${icqram_library}"
+        OUTPUT_VARIABLE icqram_library_archs OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
+    if (icqram_library_archs MATCHES "(^| )arm64( |$)")
+        if (NOT icqram_library_archs STREQUAL "arm64")
+            execute_process(COMMAND "${icqram_lipo}" "${icqram_library}" -thin arm64 -output "${icqram_library}.arm64"
+                COMMAND_ERROR_IS_FATAL ANY)
+            file(RENAME "${icqram_library}.arm64" "${icqram_library}")
+        endif()
+        list(APPEND icqram_arm_libraries "${icqram_library}")
+    else()
+        list(APPEND icqram_incompatible "${icqram_library}")
+    endif()
+endforeach()
+foreach(icqram_library IN LISTS icqram_incompatible)
+    get_filename_component(icqram_name "${icqram_library}" NAME)
+    if (NOT icqram_name STREQUAL "libswiftCore.dylib")
+        message(FATAL_ERROR "Swift runtime ${icqram_name} does not support arm64.")
+    endif()
+    foreach(icqram_consumer IN LISTS icqram_arm_libraries)
+        execute_process(COMMAND "${icqram_otool}" -L "${icqram_consumer}"
+            OUTPUT_VARIABLE icqram_dependencies COMMAND_ERROR_IS_FATAL ANY)
+        if (icqram_dependencies MATCHES "@(rpath|loader_path|executable_path)/[^\n]*libswiftCore[.]dylib"
+            OR icqram_dependencies MATCHES "Contents/Frameworks/libswiftCore[.]dylib")
+            message(FATAL_ERROR "An arm64 component still requires the bundled Intel-only libswiftCore.")
+        endif()
+    endforeach()
+    # arm64 uses the OS Swift core; this copy only serves the removed Intel slice.
+    file(REMOVE "${icqram_library}")
+endforeach()
