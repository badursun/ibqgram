+#ifdef ICQRAM_SHELL
+void IcqramAuthorization(bool request, Fn<void(QJsonObject)> done) {
+	if (@available(macOS 10.14, *)) {
+		auto center = [UNUserNotificationCenter currentNotificationCenter];
+		const auto inspect = [center, done] {
+			[center getNotificationSettingsWithCompletionHandler:^(UNNotificationSettings *settings) {
+				const auto status = settings.authorizationStatus == UNAuthorizationStatusNotDetermined ? u"notDetermined"_q
+					: settings.authorizationStatus == UNAuthorizationStatusDenied ? u"denied"_q
+					: u"authorized"_q;
+				const auto result = QJsonObject{
+					{ u"authorization"_q, status },
+					{ u"alerts"_q, settings.alertSetting == UNNotificationSettingEnabled },
+					{ u"sound"_q, settings.soundSetting == UNNotificationSettingEnabled },
+					{ u"banner"_q, settings.alertStyle != UNAlertStyleNone },
+				};
+				crl::on_main([done, result] { done(result); });
+			}];
+		};
+		if (request) {
+			[center requestAuthorizationWithOptions:(UNAuthorizationOptionAlert | UNAuthorizationOptionSound)
+				completionHandler:^(BOOL granted, NSError *error) {
+					if (error) {
+						crl::on_main([done] { done({{u"authorization"_q, u"error"_q}}); });
+					} else {
+						inspect();
+					}
+				}];
+		} else {
+			inspect();
+		}
+	} else {
+		done({{u"authorization"_q, u"unsupported"_q}});
+	}
+}
+
+void IcqramTestNotification(Fn<void(QString)> done) {
+	IcqramAuthorization(false, [done](QJsonObject state) {
+		if (state.value(u"authorization"_q).toString() != u"authorized"_q) {
+			done(u"NOTIFICATIONS_DENIED"_q);
+			return;
+		}
+		if (@available(macOS 10.14, *)) {
+			UNMutableNotificationContent *content = [[[UNMutableNotificationContent alloc] init] autorelease];
+			content.title = @"IBQgram";
+			content.body = @"Your message notifications will appear here.";
+			if (Core::App().settings().soundNotify()) content.sound = [UNNotificationSound defaultSound];
+			UNNotificationRequest *request = [UNNotificationRequest
+				requestWithIdentifier:@"icqram.notification-test" content:content trigger:nil];
+			[[UNUserNotificationCenter currentNotificationCenter] addNotificationRequest:request
+				withCompletionHandler:^(NSError *error) {
+					const auto failed = error != nil;
+					crl::on_main([done, failed] { done(failed ? u"NOTIFICATION_FAILED"_q : QString()); });
+				}];
+		}
+	});
+}
+
+void IcqramOpenNotificationSettings() {
+	[[NSWorkspace sharedWorkspace] openURL:[NSURL URLWithString:@"x-apple.systempreferences:com.apple.Notifications-Settings.extension"]];
+}
+#endif
