+#ifdef ICQRAM_SHELL
+void Tray::addIcqramPresenceMenu(Fn<QString()> current, Fn<void(QString)> select) {
+	if (!_menu) return;
+	const auto menu = _menu->addMenu(u"Durum değiştir"_q);
+	const auto group = new QActionGroup(menu);
+	group->setExclusive(true);
+	const auto states = std::vector<std::pair<QString, QString>>{
+		{u"AV"_q, u"Available / Connect"_q}, {u"FC"_q, u"Free for Chat"_q},
+		{u"AW"_q, u"Away"_q}, {u"NA"_q, u"N/A (Extended Away)"_q},
+		{u"OC"_q, u"Occupied (Urgent Msgs)"_q}, {u"DND"_q, u"DND (Do Not Disturb)"_q},
+		{u"IV"_q, u"Privacy (Invisible)"_q}, {u"OF"_q, u"Offline / Disconnect"_q},
+		{u"PH"_q, u"On the Phone"_q}, {u"LC"_q, u"Out to Lunch"_q},
+	};
+	for (const auto &[code, label] : states) {
+		const auto action = menu->addAction(label, [=] { select(code); });
+		action->setData(code);
+		action->setCheckable(true);
+		group->addAction(action);
+	}
+	QObject::connect(menu, &QMenu::aboutToShow, menu, [=] {
+		const auto code = current();
+		for (const auto action : menu->actions()) action->setChecked(action->data().toString() == code);
+	});
+}
