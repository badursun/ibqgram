+namespace Api {
+PeerId IcqramPeerId(const QString &key) {
+	static const auto pattern = QRegularExpression(u"^(?:(chat|channel):)?([1-9][0-9]{0,15})$"_q);
+	const auto match = pattern.match(key);
+	if (!match.hasMatch()) return PeerId();
+	const auto id = match.captured(2).toULongLong();
+	return match.captured(1) == u"chat"_q ? peerFromChat(ChatId(id))
+		: match.captured(1) == u"channel"_q ? peerFromChannel(ChannelId(id))
+		: peerFromUser(UserId(id));
+}
+QString IcqramPeerKey(PeerId id) {
+	return peerIsChat(id) ? u"chat:"_q + QString::number(peerToChat(id).bare)
+		: peerIsChannel(id) ? u"channel:"_q + QString::number(peerToChannel(id).bare)
+		: QString::number(peerToUser(id).bare);
+}
+namespace {
+QString PinnedKey(quint64 ownId) { return u"accounts/"_q + QString::number(ownId) + u"/listedBots"_q; }
+QStringList PinnedBots(quint64 ownId) { return QSettings(u"icqram"_q, u"icqram"_q).value(PinnedKey(ownId)).toStringList(); }
+QString ErrorCode(const MTP::Error &error) {
+	return MTP::IsFloodError(error) ? u"FLOOD_WAIT"_q : u"ACCOUNT_UNAVAILABLE"_q;
+}
+const QRegularExpression &StatusSuffix() {
+	static const auto result = QRegularExpression(u"(?:^|\\s)\\[ST:(AV|FC|AW|NA|OC|DND|IV|OF|PH|LC)\\]$"_q);
+	return result;
+}
+QJsonObject DirectoryUser(not_null<UserData*> user) {
+	const auto entry = QString::number(peerToUser(user->id).bare) + ':' + user->username();
+	return {
+		{u"listed"_q, PinnedBots(user->session().userId().bare).contains(entry)},
+		{u"id"_q, QString::number(peerToUser(user->id).bare)},
+		{u"name"_q, user->name()}, {u"username"_q, user->username()},
+		{u"firstName"_q, user->firstName}, {u"lastName"_q, user->lastName},
+		{u"contact"_q, user->isContact()}, {u"bot"_q, user->isBot()},
+		{u"verified"_q, user->isVerified()}, {u"self"_q, user->isSelf()},
+		{u"online"_q, user->lastseen().isOnline(QDateTime::currentSecsSinceEpoch())}
+	};
+}
+}
+IcqramAccount::IcqramAccount(not_null<Main::Account*> account, Fn<bool()> allowed)
+: _account(account), _allowed(std::move(allowed)), _api(&account->mtp()) {
+	_dialogsDeadline.setCallback([=] {
+		_api.request(base::take(_dialogsRequest)).cancel();
+		if (auto reply = base::take(_dialogsReply)) reply({}, u"TIMEOUT"_q);
+	});
+	_directoryDeadline.setCallback([=] {
+		_api.request(base::take(_directoryRequest)).cancel();
+		finishDirectory({}, _directoryAdding ? u"ADD_UNCERTAIN"_q : u"TIMEOUT"_q);
+	});
+	_contactsDeadline.setCallback([=] {
+		_api.request(base::take(_contactsRequest)).cancel();
+		if (auto reply = base::take(_contactsReply)) reply({}, u"TIMEOUT"_q);
+	});
+	_profileDeadline.setCallback([=] {
+		_api.request(base::take(_profileRequest)).cancel();
+		if (auto reply = base::take(_profileReply)) reply({}, u"TIMEOUT"_q);
+	});
+	_presenceDeadline.setCallback([=] {
+		_api.request(base::take(_presenceRequest)).cancel();
+		finishPresence({}, u"PRESENCE_UNCERTAIN"_q);
+	});
+}
+QString IcqramAccount::profileAvatar() const {
+	const auto session = _account->maybeSession();
+	if (!session) return {};
+	const auto user = session->user();
+	if (!user->hasUserpic()) return {};
+	if (_profileUserpic.null()) _profileUserpic = user->createUserpicView();
+	user->loadUserpic();
+	if (user->useEmptyUserpic(_profileUserpic)) return {};
+	auto bytes = QByteArray();
+	auto buffer = QBuffer(&bytes);
+	if (!buffer.open(QIODevice::WriteOnly)) return {};
+	const auto avatar = PeerData::GenerateUserpicImage(user, _profileUserpic, 96, 0);
+	if (!avatar.save(&buffer, "PNG") || bytes.size() > 65000) return {};
+	return u"data:image/png;base64,"_q + QString::fromLatin1(bytes.toBase64());
+}
+QJsonObject IcqramAccount::profile() const {
+	const auto session = _account->maybeSession();
+	if (!session) return {};
+	const auto user = session->user();
+	return {
+		{u"uin"_q, QString::number(session->userId().bare)},
+		{u"firstName"_q, user->firstName}, {u"lastName"_q, user->lastName},
+		{u"name"_q, (user->firstName + ' ' + user->lastName).trimmed()},
+		{u"username"_q, user->username()},
+		{u"avatar"_q, profileAvatar()},
+        {u"shareStatus"_q, QSettings(u"icqram"_q,u"icqram"_q).value(u"accounts/"_q + QString::number(session->userId().bare) + u"/shareStatus"_q,false).toBool()},
+        {u"localPresence"_q, QSettings(u"icqram"_q,u"icqram"_q).value(u"accounts/"_q + QString::number(session->userId().bare) + u"/presence"_q).toString()}
+	};
+}
+void IcqramAccount::request(const QString &method, const QJsonObject &params, Reply reply) {
+	if (!_allowed()) return reply({}, u"LOCKED"_q);
+	if (method == u"profile.load"_q) loadProfile(std::move(reply));
+	else if (method == u"contacts.load"_q) loadContacts(std::move(reply));
+	else if (method == u"dialogs.load"_q) loadDialogs(params.value(u"reset"_q).toBool(), std::move(reply));
+	else if (method == u"contacts.snapshot"_q) reply(contactSnapshot(), {});
+	else if (method == u"presence.set"_q) setPresence(params, std::move(reply));
+	else if (method == u"directory.search"_q) searchDirectory(params, std::move(reply));
+	else if (method == u"directory.add"_q) addDirectoryContact(params, std::move(reply));
+	else reply({}, u"UNSUPPORTED_METHOD"_q);
+}
+void IcqramAccount::loadProfile(Reply reply) {
+	if (_profileRequest) return reply({}, u"BUSY"_q);
+	_profileReply = std::move(reply); _profileDeadline.callOnce(12000);
+	_profileRequest = _api.request(MTPusers_GetUsers(MTP_vector<MTPInputUser>(1, MTP_inputUserSelf()))).done(crl::guard(this, [=](const MTPVector<MTPUser> &users) {
+		_profileRequest = 0; _profileDeadline.cancel();
+		auto done = base::take(_profileReply);
+		if (!_allowed()) return done({}, u"LOCKED"_q);
+		if (users.v.size() != 1 || users.v.front().type() != mtpc_user || !users.v.front().c_user().is_self()) return done({}, u"ACCOUNT_UNAVAILABLE"_q);
+		_account->session().data().processUsers(users);
+		done({{u"profile"_q, profile()}}, {});
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_profileRequest = 0; _profileDeadline.cancel();
+		if (auto done = base::take(_profileReply)) done({}, ErrorCode(error));
+	})).handleFloodErrors().send();
+}
+void IcqramAccount::loadContacts(Reply reply) {
+	if (_contactsReply) return reply({}, u"BUSY"_q);
+	_contactsReply = std::move(reply);
+	_contactsDeadline.callOnce(12000);
+	_contactsRequest = _api.request(MTPcontacts_GetContacts(MTP_long(0))).done(crl::guard(this, [=](const MTPcontacts_Contacts &result) {
+		_contactsRequest = 0; _contactsDeadline.cancel();
+		auto done = base::take(_contactsReply);
+		if (!_allowed()) return done({}, u"LOCKED"_q);
+		if (result.type() != mtpc_contacts_contacts) return done({}, u"CONTACTS_UNAVAILABLE"_q);
+		const auto &data = result.c_contacts_contacts();
+		auto ids = QSet<quint64>();
+		for (const auto &contact : data.vcontacts().v) {
+			if (contact.type() == mtpc_contact) ids.insert(contact.c_contact().vuser_id().v);
+		}
+		auto contacts = QJsonArray();
+		auto oldFilterExcluded = 0;
+		for (const auto &item : data.vusers().v) {
+			if (item.type() != mtpc_user) continue;
+			const auto &user = item.c_user();
+			if (!ids.contains(user.vid().v) || user.is_deleted()) continue;
+			if (user.is_self() || !user.is_contact()) ++oldFilterExcluded;
+			const auto status = user.vstatus();
+			const auto online = status && status->type() == mtpc_userStatusOnline
+				&& status->c_userStatusOnline().vexpires().v > QDateTime::currentSecsSinceEpoch();
+			const auto name = (qs(user.vfirst_name().value_or_empty()) + ' ' + qs(user.vlast_name().value_or_empty())).trimmed();
+			contacts.push_back(QJsonObject{
+				{u"id"_q, QString::number(user.vid().v)}, {u"name"_q, name.isEmpty() ? u"Telegram kullanıcısı"_q : name},
+				{u"username"_q, qs(user.vusername().value_or_empty())}, {u"self"_q, user.is_self()},
+				{u"state"_q, online ? u"online"_q : u"offline"_q},
+				{u"detail"_q, online ? u"Telegram: çevrimiçi"_q : u"Telegram çevrimiçi bilgisi görünmüyor."_q}
+			});
+		}
+		_account->session().data().processUsers(data.vusers());
+		LOG(("icqram contacts: members=%1 users=%2 returned=%3 oldFilterExcluded=%4")
+			.arg(ids.size()).arg(data.vusers().v.size()).arg(contacts.size()).arg(oldFilterExcluded));
+		_contactIds = ids;
+		_contactsReply = std::move(done);
+		_contactsDeadline.callOnce(12000);
+		loadPinnedContacts(PinnedBots(_account->session().userId().bare));
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_contactsRequest = 0; _contactsDeadline.cancel();
+		if (auto done = base::take(_contactsReply)) done({}, ErrorCode(error));
+	})).handleFloodErrors().send();
+}
+void IcqramAccount::loadDialogs(bool reset, Reply reply) {
+	if (_dialogsReply) return reply({}, u"BUSY"_q);
+	if (reset) {
+		_dialogIds.clear(); _dialogFolder = 0; _dialogOffsetDate = 0;
+		_dialogOffsetId = 0; _dialogOffsetPeer = PeerId();
+		_dialogFirstPage = true; _dialogsComplete = false;
+	}
+	if (_dialogsComplete) return reply(contactSnapshot(), {});
+	_dialogsReply = std::move(reply);
+	_dialogsDeadline.callOnce(12000);
+	const auto offsetPeer = _dialogOffsetPeer
+		? _account->session().data().peerLoaded(_dialogOffsetPeer) : nullptr;
+	const auto flags = MTPmessages_GetDialogs::Flag::f_folder_id
+		| (_dialogFirstPage ? MTPmessages_GetDialogs::Flags() : MTPmessages_GetDialogs::Flag::f_exclude_pinned);
+	_dialogsRequest = _api.request(MTPmessages_GetDialogs(
+		MTP_flags(flags), MTP_int(_dialogFolder), MTP_int(_dialogOffsetDate),
+		MTP_int(_dialogOffsetId), offsetPeer ? offsetPeer->input() : MTP_inputPeerEmpty(),
+		MTP_int(100), MTP_long(0)))
+	.done(crl::guard(this, [=](const MTPmessages_Dialogs &result) {
+		_dialogsRequest = 0; _dialogsDeadline.cancel();
+		auto done = base::take(_dialogsReply);
+		if (!_allowed()) return done({}, u"LOCKED"_q);
+		auto nextDate = 0, nextId = 0;
+		auto nextPeer = PeerId();
+		auto complete = result.type() != mtpc_messages_dialogsSlice;
+		result.match([&](const MTPDmessages_dialogsNotModified &) {
+		}, [&](const auto &data) {
+			auto &session = _account->session().data();
+			session.processUsers(data.vusers()); session.processChats(data.vchats());
+			session.applyDialogs(_dialogFolder ? session.folder(_dialogFolder).get() : nullptr,
+				data.vmessages().v, data.vdialogs().v);
+			for (const auto &value : data.vdialogs().v) {
+				if (value.type() != mtpc_dialog) continue;
+				const auto &dialog = value.c_dialog();
+				const auto peerId = peerFromMTP(dialog.vpeer());
+				if (peerId) _dialogIds.insert(peerId);
+				if (dialog.is_pinned()) continue;
+				for (const auto &message : data.vmessages().v) {
+					if (PeerFromMessage(message) == peerId && IdFromMessage(message).bare == dialog.vtop_message().v) {
+						nextDate = DateFromMessage(message); nextId = dialog.vtop_message().v; nextPeer = peerId;
+						break;
+					}
+				}
+			}
+			if (data.vdialogs().v.empty()) complete = true;
+		});
+		if (!complete && !nextPeer && _dialogFirstPage) {
+			_dialogFirstPage = false;
+		} else if (complete || !nextPeer
+			|| (nextPeer == _dialogOffsetPeer && nextId == _dialogOffsetId)) {
+			if (_dialogFolder == 0) {
+				_dialogFolder = 1; _dialogOffsetDate = 0; _dialogOffsetId = 0;
+				_dialogOffsetPeer = PeerId(); _dialogFirstPage = true;
+			} else _dialogsComplete = true;
+		} else {
+			_dialogOffsetPeer = nextPeer; _dialogOffsetId = nextId;
+			_dialogOffsetDate = nextDate; _dialogFirstPage = false;
+		}
+		done(contactSnapshot(), {});
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_dialogsRequest = 0; _dialogsDeadline.cancel();
+		if (auto done = base::take(_dialogsReply)) done({}, ErrorCode(error));
+	})).handleFloodErrors().send();
+}
+QJsonObject IcqramAccount::contactSnapshot() const {
+	auto contacts = QJsonArray();
+	auto ids = _dialogIds;
+	for (const auto id : _contactIds) ids.insert(peerFromUser(UserId(id)));
+	for (const auto id : ids) {
+		const auto peer = _account->session().data().peerLoaded(id);
+		if (!peer) continue;
+		const auto user = peer->asUser();
+		if (user && (user->isInaccessible() || (user->isSelf() && !_contactIds.contains(peerToUser(id).bare)))) continue;
+		if (const auto chat = peer->asChat()) { if (!chat->amIn() || chat->migrateTo()) continue; }
+		if (const auto channel = peer->asChannel()) { if (!channel->amIn()) continue; }
+		const auto online = user && !user->isBot() && user->lastseen().isOnline(QDateTime::currentSecsSinceEpoch());
+		const auto history = _account->session().data().history(peer);
+		const auto painter = history->sendActionPainter(); painter->updateNeedsAnimating(crl::now());
+		const auto kind = user ? (user->isBot() ? u"bot"_q : u"user"_q) : peer->isBroadcast() ? u"channel"_q : u"group"_q;
+		auto item = user ? DirectoryUser(user) : QJsonObject{
+			{u"id"_q,IcqramPeerKey(id)}, {u"name"_q,peer->name()}, {u"username"_q,peer->username()}};
+		item.insert(u"kind"_q,kind);
+		item.insert(u"state"_q,online ? u"online"_q : u"offline"_q);
+		item.insert(u"blocked"_q,user && user->isBlocked());
+		item.insert(u"typing"_q,painter->actionText());
+		item.insert(u"unread"_q,history->unreadCountKnown() ? history->unreadCount() : 0);
+		item.insert(u"detail"_q,kind == u"group"_q ? u"Telegram grubu"_q : kind == u"channel"_q ? u"Telegram kanalı"_q : kind == u"bot"_q ? u"Telegram botu"_q : online ? u"Online"_q : u"Offline"_q);
+		contacts.push_back(item);
+	}
+	return {{u"contacts"_q,contacts}, {u"hasMoreDialogs"_q,!_dialogsComplete},
+		{u"profileAvatar"_q, QJsonObject{{u"uin"_q, QString::number(_account->session().userId().bare)}, {u"avatar"_q, profileAvatar()}}}};
+}
+void IcqramAccount::loadPinnedContacts(QStringList entries, int index) {
+	if (!_contactsReply) return;
+	if (!_allowed()) { _contactsDeadline.cancel(); auto done = base::take(_contactsReply); return done({}, u"LOCKED"_q); }
+	if (index >= entries.size() || index >= 100) {
+        for (const auto id : _contactIds) {
+            if (const auto user = _account->session().data().userLoaded(UserId(id))) {
+                _account->session().data().histories().requestDialogEntry(_account->session().data().history(user));
+            }
+        }
+		_contactsDeadline.cancel(); _contactsRequest = 0;
+		auto done = base::take(_contactsReply); return done(contactSnapshot(), {});
+	}
+	const auto entry = entries[index];
+	const auto id = entry.section(':', 0, 0).toULongLong();
+	const auto username = entry.section(':', 1);
+	if (!id || username.isEmpty()) return loadPinnedContacts(entries, index + 1);
+	if (const auto user = _account->session().data().userLoaded(UserId(id)); user && user->accessHash()) {
+		_contactIds.insert(id); return loadPinnedContacts(entries, index + 1);
+	}
+	_contactsRequest = _api.request(MTPcontacts_ResolveUsername(MTP_flags(0), MTP_string(username), MTPstring()))
+	.done(crl::guard(this, [=](const MTPcontacts_ResolvedPeer &result) {
+		_contactsRequest = 0;
+		if (!_contactsReply || !_allowed()) return;
+		const auto &data = result.c_contacts_resolvedPeer();
+		_account->session().data().processUsers(data.vusers());
+		if (data.vpeer().type() == mtpc_peerUser && data.vpeer().c_peerUser().vuser_id().v == id) _contactIds.insert(id);
+		loadPinnedContacts(entries, index + 1);
+	})).fail(crl::guard(this, [=](const MTP::Error &) { _contactsRequest = 0; loadPinnedContacts(entries, index + 1); })).handleFloodErrors().send();
+}
+void IcqramAccount::finishDirectory(QJsonObject result, QString error) {
+	_directoryDeadline.cancel(); _directoryRequest = 0; _directoryAdding = false;
+	if (auto done = base::take(_directoryReply)) done(std::move(result), std::move(error));
+}
+void IcqramAccount::searchDirectory(const QJsonObject &params, Reply reply) {
+	if (_directoryReply) return reply({}, u"BUSY"_q);
+	if (crl::now() < _retryDirectoryAt) return reply({}, u"FLOOD_WAIT"_q);
+	const auto mode = params.value(u"mode"_q).toString();
+	auto query = params.value(u"query"_q).toString().trimmed();
+	_directoryIds.clear();
+	if (mode == u"uin"_q) {
+		static const auto valid = QRegularExpression(u"^[1-9][0-9]{0,15}$"_q);
+		if (!valid.match(query).hasMatch()) return reply({}, u"INVALID_QUERY"_q);
+		const auto user = _account->session().data().userLoaded(UserId(query.toULongLong()));
+		auto users = QJsonArray();
+		if (user && !user->isInaccessible() && (user->accessHash() || user->isSelf())) {
+			users.push_back(DirectoryUser(user)); _directoryIds.insert(query.toULongLong());
+		}
+		return reply({{u"users"_q, users}, {u"knownOnly"_q, true}}, {});
+	}
+	if (mode != u"username"_q) return reply({}, u"UNSUPPORTED_SEARCH"_q);
+	if (query.startsWith('@')) query.remove(0, 1);
+	static const auto valid = QRegularExpression(u"^[A-Za-z0-9_]{5,32}$"_q);
+	if (!valid.match(query).hasMatch()) return reply({}, u"INVALID_QUERY"_q);
+	_directoryReply = std::move(reply); _directoryDeadline.callOnce(12000);
+	_directoryRequest = _api.request(MTPcontacts_Search(MTP_flags(0), MTP_string(query), MTP_int(50)))
+	.done(crl::guard(this, [=](const MTPcontacts_Found &result) {
+		if (!_allowed()) return finishDirectory({}, u"LOCKED"_q);
+		const auto &data = result.c_contacts_found();
+		_account->session().data().processUsers(data.vusers());
+		auto users = QJsonArray();
+		const auto collect = [&](const auto &peers) {
+			for (const auto &peer : peers.v) {
+				if (peer.type() != mtpc_peerUser) continue;
+				const auto id = peer.c_peerUser().vuser_id().v;
+				const auto user = _account->session().data().userLoaded(UserId(id));
+				if (!user || user->isInaccessible() || _directoryIds.contains(id) || (!user->accessHash() && !user->isSelf())) continue;
+				_directoryIds.insert(id); users.push_back(DirectoryUser(user));
+			}
+		};
+		collect(data.vmy_results()); collect(data.vresults());
+		_retryDirectoryAt = crl::now() + 1000;
+		finishDirectory({{u"users"_q, users}}, {});
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		if (MTP::IsFloodError(error)) _retryDirectoryAt = crl::now() + crl::time(std::clamp(error.type().section('_', -1).toInt(), 30, 86400)) * 1000;
+		finishDirectory({}, MTP::IgnoreError(error) ? u"SILENT"_q : ErrorCode(error));
+	})).handleFloodErrors().send();
+}
+void IcqramAccount::addDirectoryContact(const QJsonObject &params, Reply reply) {
+	if (_directoryReply) return reply({}, u"BUSY"_q);
+	if (crl::now() < _retryDirectoryAt) return reply({}, u"FLOOD_WAIT"_q);
+	const auto id = params.value(u"id"_q).toString().toULongLong();
+	const auto user = _directoryIds.contains(id) ? _account->session().data().userLoaded(UserId(id)) : nullptr;
+	if (!user || user->isInaccessible()) return reply({}, u"PEER_UNAVAILABLE"_q);
+	if (user->isSelf()) return reply({}, u"OPEN_CHAT_INSTEAD"_q);
+	if (user->isBot()) {
+		auto settings = QSettings(u"icqram"_q, u"icqram"_q);
+		const auto key = PinnedKey(_account->session().userId().bare);
+		auto entries = settings.value(key).toStringList();
+		const auto entry = QString::number(id) + ':' + user->username();
+		if (!entries.contains(entry)) { if (entries.size() >= 100) return reply({}, u"LIST_FULL"_q); entries.push_back(entry); }
+		settings.setValue(key, entries); settings.sync();
+		if (settings.status() != QSettings::NoError) return reply({}, u"SAVE_FAILED"_q);
+		return reply({{u"added"_q, true}, {u"listed"_q, true}}, {});
+	}
+	if (user->isContact()) return reply({{u"added"_q, true}}, {});
+	_directoryAdding = true; _directoryReply = std::move(reply); _directoryDeadline.callOnce(12000);
+	_directoryRequest = _api.request(MTPcontacts_AddContact(
+		MTP_flags(0), user->inputUser(), MTP_string(user->firstName), MTP_string(user->lastName), MTP_string(QString()), MTPTextWithEntities()
+	)).done(crl::guard(this, [=](const MTPUpdates &updates) {
+		if (!_allowed()) return finishDirectory({}, u"LOCKED"_q);
+		_account->session().api().applyUpdates(updates);
+		finishDirectory({{u"added"_q, true}}, {});
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		if (MTP::IsFloodError(error)) _retryDirectoryAt = crl::now() + crl::time(std::clamp(error.type().section('_', -1).toInt(), 30, 86400)) * 1000;
+		finishDirectory({}, MTP::IgnoreError(error) ? u"SILENT"_q : ErrorCode(error));
+	})).handleFloodErrors().send();
+}
+void IcqramAccount::finishPresence(QJsonObject result, QString error) {
+	_presenceDeadline.cancel(); _presenceRequest = 0;
+	if (auto done = base::take(_presenceReply)) done(std::move(result), std::move(error));
+}
+void IcqramAccount::setPresence(const QJsonObject &params, Reply reply) {
+	const auto code = params.value(u"code"_q).toString();
+	static const auto codes = QSet<QString>{ u"AV"_q,u"FC"_q,u"AW"_q,u"NA"_q,u"OC"_q,u"DND"_q,u"IV"_q,u"OF"_q,u"PH"_q,u"LC"_q,u""_q };
+	if (!codes.contains(code) || !params.value(u"publish"_q).toBool()) return reply({}, u"PRESENCE_INVALID"_q);
+	if (params.contains(u"shareChanges"_q) && !params.value(u"shareChanges"_q).isBool()) return reply({}, u"PRESENCE_INVALID"_q);
+    if (_presenceReply) return reply({}, u"BUSY"_q);
+	if (crl::now() < _retryPresenceAt) return reply({}, u"FLOOD_WAIT"_q);
+	_presenceReply = std::move(reply); _presenceDeadline.callOnce(20000);
+    const auto success = crl::guard(this, [=] {
+        if (params.contains(u"shareChanges"_q)) {
+            auto settings=QSettings(u"icqram"_q,u"icqram"_q);
+            settings.setValue(u"accounts/"_q + QString::number(_account->session().userId().bare) + u"/shareStatus"_q,params.value(u"shareChanges"_q).toBool());
+            settings.sync();
+            if(settings.status()!=QSettings::NoError)return finishPresence({},u"SAVE_FAILED"_q);
+        }
+        finishPresence({{u"profile"_q,profile()}},{});
+    });
+	const auto fail = crl::guard(this, [=](const MTP::Error &error) {
+		if (MTP::IsFloodError(error)) {
+			const auto seconds = error.type().section('_', -1).toInt();
+			_retryPresenceAt = crl::now() + crl::time(std::clamp(seconds, 30, 86400)) * 1000;
+		}
+		finishPresence({}, ErrorCode(error));
+	});
+	_presenceRequest = _api.request(MTPusers_GetUsers(MTP_vector<MTPInputUser>(1, MTP_inputUserSelf()))).done(crl::guard(this, [=](const MTPVector<MTPUser> &users) {
+		if (!_allowed()) return finishPresence({}, u"LOCKED"_q);
+		if (users.v.size() != 1 || users.v.front().type() != mtpc_user || !users.v.front().c_user().is_self()) return finishPresence({}, u"ACCOUNT_UNAVAILABLE"_q);
+		_account->session().data().processUsers(users);
+		const auto current = profile();
+		if (current.value(u"firstName"_q) != params.value(u"firstName"_q) || current.value(u"lastName"_q) != params.value(u"lastName"_q)) {
+			return finishPresence({}, u"PROFILE_CHANGED"_q);
+		}
+		const auto last = current.value(u"lastName"_q).toString().remove(StatusSuffix()).trimmed();
+		const auto next = code.isEmpty() ? last : (last + (last.isEmpty() ? u""_q : u" "_q) + u"[ST:"_q + code + ']').trimmed();
+		if (next.size() > 64) return finishPresence({}, u"NAME_TOO_LONG"_q);
+		if (next == current.value(u"lastName"_q).toString()) return success();
+		_presenceRequest = _api.request(MTPaccount_UpdateProfile(
+			MTP_flags(MTPaccount_UpdateProfile::Flag::f_last_name), MTPstring(), MTP_string(next), MTPstring()
+		)).done(crl::guard(this, [=](const MTPUser &user) {
+			if (!_allowed()) return finishPresence({}, u"LOCKED"_q);
+			_account->session().data().processUser(user);
+			_retryPresenceAt = crl::now() + 5000;
+			success();
+		})).fail(fail).handleFloodErrors().send();
+	})).fail(fail).handleFloodErrors().send();
+}
+}
