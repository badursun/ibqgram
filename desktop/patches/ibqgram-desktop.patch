+#pragma once
+
+#include "ui/rp_widget.h"
+#include "base/timer.h"
+#include "mtproto/sender.h"
+#include <map>
+#include <QtCore/QJsonObject>
+#include <QtCore/QPointer>
+
+namespace Webview {
+class Window;
+} // namespace Webview
+namespace Main { class Account; }
+namespace Intro {
+class IcqramAuth;
+namespace details { struct Data; }
+}
+namespace Api { class IcqramAccount; class IcqramChat; }
+
+
+namespace Window {
+class Controller;
+
+class IcqramShell final : public Ui::RpWidget {
+public:
+	IcqramShell(QWidget *parent, not_null<Main::Account*> account, not_null<Controller*> controller, QString peerId = {}, int mediaId = 0, Api::IcqramChat *mediaApi = nullptr, QJsonObject panelData = {});
+	~IcqramShell();
+
+	static bool ShowMain(bool currentScreen = false);
+	static bool ShowSettings();
+	static bool OpenNotificationChat(Main::Account *account, PeerId peer, MsgId topic);
+	static bool IsReadingChat(const Main::Account *account, PeerId peer, MsgId topic);
+	static QString LocalPresence();
+	static void SetLocalPresence(const QString &code);
+	static void HideAll();
+	static void UpdateDockVisibility();
+	void focus();
+	void showAbout();
+	void setLocked(bool locked);
+
+protected:
+	void hideEvent(QHideEvent *event) override;
+	void showEvent(QShowEvent *event) override;
+
+private:
+	void sendReply(qint64 id, QJsonObject result, QString error = {});
+	void finishStartup();
+	void openAuxiliary(const QString &kind, QJsonObject data = {});
+	QPointer<IcqramShell> _commandOwner;
+	int _commandTopic = 0;
+	bool _startupActive = false;
+	base::Timer _startupDeadline;
+	const not_null<Main::Account*> _account;
+	const not_null<Controller*> _controller;
+	const QString _peerId;
+	std::map<QString, std::unique_ptr<IcqramShell>> _chats;
+	std::unique_ptr<Api::IcqramChat> _chatApi;
+	const int _mediaId;
+	Api::IcqramChat *const _mediaApi;
+	std::unique_ptr<IcqramShell> _viewer;
+	bool _restoreAfterLock = false;
+	QString _presenceCode = u"AV"_q;
+	std::unique_ptr<Webview::Window> _webview;
+	std::unique_ptr<Intro::details::Data> _authData;
+	std::unique_ptr<Intro::IcqramAuth> _auth;
+	std::unique_ptr<Api::IcqramAccount> _accountApi;
+	QPoint _dragOrigin;
+	QPoint _dragPointer;
+	bool _dragging = false;
+	bool _locked = false;
+
+};
+
+} // namespace Window
