+bool ShowIcqramStartup(const QString &uiDirectory) {
+	if (StartupShown) return false;
+	StartupShown = true;
+	auto screen = NSScreen.mainScreen;
+	for (NSScreen *candidate in NSScreen.screens) {
+		if (NSPointInRect(NSEvent.mouseLocation, candidate.frame)) screen = candidate;
+	}
+	if (!screen) return false;
+	StartupPanel = [[NSPanel alloc] initWithContentRect:screen.frame
+		styleMask:NSWindowStyleMaskBorderless | NSWindowStyleMaskNonactivatingPanel
+		backing:NSBackingStoreBuffered defer:NO];
+	StartupPanel.title = @"IBQgram — Starting";
+	StartupPanel.opaque = NO;
+	StartupPanel.backgroundColor = NSColor.clearColor;
+	StartupPanel.hasShadow = NO;
+	StartupPanel.level = NSStatusWindowLevel + 1;
+	StartupPanel.collectionBehavior = NSWindowCollectionBehaviorCanJoinAllSpaces | NSWindowCollectionBehaviorFullScreenAuxiliary;
+	StartupPanel.ignoresMouseEvents = YES;
+	const auto bounds = NSMakeRect(0, 0, screen.frame.size.width, screen.frame.size.height);
+	auto blur = [[NSVisualEffectView alloc] initWithFrame:bounds];
+	blur.material = NSVisualEffectMaterialHUDWindow;
+	blur.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+	blur.state = NSVisualEffectStateActive;
+	blur.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+	StartupPanel.contentView = blur;
+	auto configuration = [[WKWebViewConfiguration alloc] init];
+	configuration.websiteDataStore = WKWebsiteDataStore.nonPersistentDataStore;
+	configuration.preferences.javaScriptEnabled = NO;
+	configuration.allowsAirPlayForMediaPlayback = NO;
+	auto web = [[WKWebView alloc] initWithFrame:bounds configuration:configuration];
+	[web setValue:@NO forKey:@"drawsBackground"];
+	web.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+	[blur addSubview:web];
+	const auto directory = [NSURL fileURLWithPath:uiDirectory.toNSString() isDirectory:YES];
+	[web loadFileURL:[directory URLByAppendingPathComponent:@"startup.html"] allowingReadAccessToURL:directory];
+	[StartupPanel orderFrontRegardless];
+	[web release];
+	[configuration release];
+	[blur release];
+	return true;
+}
+void HideIcqramStartup() {
+	if (!StartupPanel) return;
+	[StartupPanel orderOut:nil];
+	[StartupPanel release];
+	StartupPanel = nil;
+}
+
+void MoveIcqramToCurrentSpace(not_null<QWidget*> widget) {
+	const auto window = [reinterpret_cast<NSView*>(widget->winId()) window];
+	window.collectionBehavior = (window.collectionBehavior & ~NSWindowCollectionBehaviorCanJoinAllSpaces) | NSWindowCollectionBehaviorMoveToActiveSpace;
+}
