diff --git a/Telegram/SourceFiles/intro/intro_icqram_auth.cpp b/Telegram/SourceFiles/intro/intro_icqram_auth.cpp
new file mode 100644
index 0000000000..08fe739ce1
--- /dev/null
+++ b/Telegram/SourceFiles/intro/intro_icqram_auth.cpp
@@ -0,0 +1,194 @@
+#include "intro/intro_icqram_auth.h"
+
+#include "intro/intro_widget.h"
+#include "main/main_account.h"
+#include "core/core_cloud_password.h"
+#include "base/random.h"
+#include <QtCore/QRegularExpression>
+
+namespace Intro {
+
+IcqramAuth::IcqramAuth(QWidget *parent, not_null<Main::Account*> account, not_null<details::Data*> data)
+: Step(parent, account, data)
+, _deadline([=] {
+	apiClear();
+	complete(u"TIMEOUT"_q);
+}) {
+}
+
+IcqramAuth::~IcqramAuth() {
+	_deadline.cancel();
+	clearPassword();
+	apiClear();
+}
+
+QJsonObject IcqramAuth::state() const {
+	return { { u"auth"_q, _state }, { u"connected"_q, false }, { u"codeLength"_q, _codeLength } };
+}
+
+void IcqramAuth::clearPassword() {
+	_password.fill('\0');
+	_password.clear();
+}
+
+void IcqramAuth::complete(QString error) {
+	_deadline.cancel();
+	clearPassword();
+	if (const auto reply = base::take(_reply)) {
+		reply(state(), std::move(error));
+	}
+}
+
+void IcqramAuth::request(const QString &method, const QJsonObject &params, Reply reply) {
+	if (method == u"auth.reset"_q) {
+		apiClear();
+		complete(u"CANCELLED"_q);
+		_phone.clear();
+		_phoneHash.clear();
+		_state = u"phone"_q;
+		_codeLength = 0;
+		reply(state(), {});
+		return;
+	}
+	if (_reply) {
+		reply({}, u"BUSY"_q);
+		return;
+	}
+	if (crl::now() < _retryAfter) {
+		reply({}, u"FLOOD_WAIT"_q);
+		return;
+	}
+	if (method != u"auth."_q + _state) {
+		reply({}, u"AUTH_STATE_INVALID"_q);
+		return;
+	}
+	_reply = std::move(reply);
+	_deadline.callOnce(12000);
+	if (_state == u"phone"_q) {
+		const auto phone = params.value(u"phone"_q).toString();
+		if (!QRegularExpression(u"^\\+[1-9][0-9]{6,14}$"_q).match(phone).hasMatch()) {
+			return complete(u"PHONE_NUMBER_INVALID"_q);
+		}
+		_phone = phone;
+		sendPhone();
+	} else if (_state == u"code"_q) {
+		const auto code = params.value(u"code"_q).toString();
+		if (_phoneHash.isEmpty() || code.size() != _codeLength
+			|| !QRegularExpression(u"^[0-9]+$"_q).match(code).hasMatch()) {
+			return complete(u"PHONE_CODE_INVALID"_q);
+		}
+		sendCode(code);
+	} else {
+		const auto password = params.value(u"password"_q).toString();
+		if (password.isEmpty() || password.size() > 1024) {
+			return complete(u"PASSWORD_HASH_INVALID"_q);
+		}
+		_password = password.toUtf8();
+		sendPassword();
+	}
+}
+
+void IcqramAuth::sendPhone() {
+	api().instance().setUserPhone(_phone);
+	api().request(MTPauth_SendCode(
+		MTP_string(_phone), MTP_int(ApiId), MTP_string(ApiHash),
+		MTP_codeSettings(MTP_flags(0), MTPVector<MTPbytes>(), MTPstring(), MTPBool())
+	)).done(crl::guard(this, [=](const MTPauth_SentCode &result) {
+		sentCode(result);
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		failed(error);
+	})).handleFloodErrors().send();
+}
+
+void IcqramAuth::sentCode(const MTPauth_SentCode &result) {
+	result.match([&](const MTPDauth_sentCode &data) {
+		_emailCode = false;
+		const auto &type = data.vtype();
+		switch (type.type()) {
+		case mtpc_auth_sentCodeTypeApp: _codeLength = type.c_auth_sentCodeTypeApp().vlength().v; break;
+		case mtpc_auth_sentCodeTypeSms: _codeLength = type.c_auth_sentCodeTypeSms().vlength().v; break;
+		case mtpc_auth_sentCodeTypeCall: _codeLength = type.c_auth_sentCodeTypeCall().vlength().v; break;
+		case mtpc_auth_sentCodeTypeEmailCode:
+			_codeLength = type.c_auth_sentCodeTypeEmailCode().vlength().v;
+			_emailCode = true;
+			break;
+		default: return complete(u"AUTH_METHOD_UNSUPPORTED"_q);
+		}
+		if (_codeLength < 1 || _codeLength > 12) {
+			return complete(u"AUTH_METHOD_UNSUPPORTED"_q);
+		}
+		_phoneHash = qba(data.vphone_code_hash());
+		_state = u"code"_q;
+		complete();
+	}, [&](const MTPDauth_sentCodeSuccess &data) {
+		authorized(data.vauthorization());
+	}, [&](const MTPDauth_sentCodePaymentRequired &) {
+		complete(u"AUTH_PAYMENT_REQUIRED"_q);
+	});
+}
+
+void IcqramAuth::sendCode(const QString &code) {
+	api().request(MTPauth_SignIn(
+		MTP_flags(_emailCode ? MTPauth_SignIn::Flag::f_email_verification : MTPauth_SignIn::Flag::f_phone_code),
+		MTP_string(_phone), MTP_bytes(_phoneHash), MTP_string(code),
+		MTP_emailVerificationCode(MTP_string(_emailCode ? code : QString()))
+	)).done(crl::guard(this, [=](const MTPauth_Authorization &result) {
+		authorized(result);
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		if (error.type() == u"SESSION_PASSWORD_NEEDED"_q) {
+			_state = u"password"_q;
+			complete();
+		} else {
+			failed(error);
+		}
+	})).handleFloodErrors().send();
+}
+
+void IcqramAuth::sendPassword() {
+	api().request(MTPaccount_GetPassword()).done(crl::guard(this, [=](const MTPaccount_Password &result) {
+		const auto &data = result.data();
+		base::RandomAddSeed(bytes::make_span(data.vsecure_random().v));
+		const auto state = Core::ParseCloudPasswordState(data);
+		if (!state.mtp.request || !state.mtp.request.id) {
+			return complete(u"AUTH_METHOD_UNSUPPORTED"_q);
+		}
+		auto hash = Core::ComputeCloudPasswordHash(state.mtp.request.algo, bytes::make_span(_password));
+		clearPassword();
+		const auto check = Core::ComputeCloudPasswordCheck(state.mtp.request, hash);
+		std::fill(hash.begin(), hash.end(), std::byte{0});
+		if (!check) {
+			return complete(u"PASSWORD_CHECK_FAILED"_q);
+		}
+		api().request(MTPauth_CheckPassword(check.result)).done(crl::guard(this, [=](const MTPauth_Authorization &auth) {
+			authorized(auth);
+		})).fail(crl::guard(this, [=](const MTP::Error &error) {
+			failed(error);
+		})).handleFloodErrors().send();
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		failed(error);
+	})).handleFloodErrors().send();
+}
+
+void IcqramAuth::authorized(const MTPauth_Authorization &result) {
+	clearPassword();
+	if (result.type() != mtpc_auth_authorization) {
+		return complete(u"SIGNUP_REQUIRED"_q);
+	}
+	const auto &user = result.c_auth_authorization().vuser();
+	if (user.type() != mtpc_user || !user.c_user().is_self() || !user.c_user().vid().v) {
+		return complete(u"AUTH_RESULT_INVALID"_q);
+	}
+	finish(result);
+}
+
+void IcqramAuth::failed(const MTP::Error &error) {
+	const auto type = error.type();
+	if (MTP::IsFloodError(error)) {
+		const auto seconds = std::clamp(type.section('_', -1).toInt(), 1, 86400);
+		_retryAfter = crl::now() + crl::time(seconds) * 1000;
+		return complete(u"FLOOD_WAIT"_q);
+	}
+	complete(MTP::IgnoreError(error) ? u"SILENT"_q : type);
+}
+
+} // namespace Intro
diff --git a/Telegram/SourceFiles/intro/intro_icqram_auth.h b/Telegram/SourceFiles/intro/intro_icqram_auth.h
new file mode 100644
index 0000000000..ca710d2dd2
--- /dev/null
+++ b/Telegram/SourceFiles/intro/intro_icqram_auth.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include "intro/intro_step.h"
+#include "base/timer.h"
+#include <QtCore/QJsonObject>
+
+namespace Intro {
+
+class IcqramAuth final : public details::Step {
+public:
+	using Reply = Fn<void(QJsonObject, QString)>;
+	IcqramAuth(QWidget *parent, not_null<Main::Account*> account, not_null<details::Data*> data);
+	~IcqramAuth();
+	void submit() override {}
+	void request(const QString &method, const QJsonObject &params, Reply reply);
+	[[nodiscard]] QJsonObject state() const;
+
+private:
+	void sentCode(const MTPauth_SentCode &result);
+	void authorized(const MTPauth_Authorization &result);
+	void failed(const MTP::Error &error);
+	void complete(QString error = {});
+	void clearPassword();
+	void sendPhone();
+	void sendCode(const QString &code);
+	void sendPassword();
+
+	QString _state = u"phone"_q;
+	QString _phone;
+	QByteArray _phoneHash;
+	QByteArray _password;
+	int _codeLength = 0;
+	bool _emailCode = false;
+	Reply _reply;
+	base::Timer _deadline;
+	crl::time _retryAfter = 0;
+};
+
+} // namespace Intro
diff --git a/Telegram/SourceFiles/mainwindow.cpp b/Telegram/SourceFiles/mainwindow.cpp
index a140f67faf..b349578ccf 100644
