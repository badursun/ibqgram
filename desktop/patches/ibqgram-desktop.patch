+IcqramChat::IcqramChat(not_null<Main::Account*> account, QString peerId, Fn<bool()> allowed, Fn<void()> changed)
+: _account(account)
+, _peerId(std::move(peerId))
+, _allowed(std::move(allowed))
+, _api(&account->mtp()) {
+	_topicsDeadline.setCallback([=] { _api.request(base::take(_topicsRequest)).cancel(); if (auto reply = base::take(_topicsReply)) reply({}, u"TIMEOUT"_q); });
+	_uploadDeadline.setCallback([=] { _api.request(base::take(_uploadRequest)).cancel(); failUpload(u"TIMEOUT"_q); });
+	_blockDeadline.setCallback([=] { _api.request(base::take(_blockRequest)).cancel(); if (auto reply = base::take(_blockReply)) reply({}, u"TIMEOUT"_q); });
+	_historyDeadline.setCallback([=] {
+		_api.request(base::take(_historyRequest)).cancel();
+		if (auto reply = base::take(_historyReply)) reply({}, u"TIMEOUT"_q);
+	});
+	_sendDeadline.setCallback([=] {
+		_api.request(base::take(_sendRequest)).cancel();
+		if (auto reply = base::take(_sendReply)) reply({}, u"SEND_UNCERTAIN"_q);
+	});
+	if (const auto user = peer()) {
+		_userpic = user->createUserpicView();
+		user->loadUserpic();
+		account->session().api().requestFullPeer(user);
+		const auto history = account->session().data().history(user);
+		account->session().local().readDraftsWithCursors(history);
+		account->session().data().histories().requestDialogEntry(history);
+	}
+	account->session().downloaderTaskFinished() | rpl::on_next([=] {
+		const auto user = peer();
+		if (_awaitingPhoto && user && !user->useEmptyUserpic(_userpic)) {
+			_awaitingPhoto = false;
+			if (_allowed()) changed();
+		}
+	}, _lifetime);
+	using Flag = Data::MessageUpdate::Flag;
+	account->session().changes().messageUpdates(Flag::NewAdded | Flag::NewMaybeAdded | Flag::Edited | Flag::Destroyed)
+		| rpl::on_next([=](const Data::MessageUpdate &update) {
+			if (_allowed() && update.item->history()->peer == peer()) changed();
+		}, _lifetime);
+}
+IcqramChat::~IcqramChat() { cancelMedia(_playbackId); }
+PeerData *IcqramChat::peer() const {
+	const auto session = _account->maybeSession();
+	return session ? session->data().peerLoaded(IcqramPeerId(_peerId)) : nullptr;
+}
+Data::ForumTopic *IcqramChat::topic() const {
+    return peer() && _topicId ? peer()->forumTopicFor(MsgId(_topicId)) : nullptr;
+}
+bool IcqramChat::canSend(bool files) const {
+    const auto right = files ? ChatRestriction::SendFiles : ChatRestriction::SendOther;
+    if (peer()->isForum()) {
+        const auto selected = topic();
+        return selected && !selected->dying() && !selected->hidden() && Data::CanSend(selected, right);
+    }
+    return Data::CanSend(peer(), right);
+}
+MTPInputReplyTo IcqramChat::replyTo() const {
+    if (!_topicId || _topicId == 1) return MTPInputReplyTo();
+    return Data::ReplyToForMTP(_account->session().data().history(peer()), FullReplyTo{
+        .messageId = FullMsgId(peer()->id, MsgId(_topicId)),
+        .topicRootId = MsgId(_topicId),
+    });
+}
+void IcqramChat::topics(bool reset, Reply reply) {
+    const auto forum = peer()->forum();
+    if (!forum) return reply({{u"topics"_q, QJsonArray()}, {u"hasMore"_q, false}}, {});
+    if (_topicsRequest) return reply({}, u"BUSY"_q);
+    if (reset) { _topicIds.clear(); _topicOffsetDate = _topicOffsetId = _topicOffsetTopic = 0; _topicsComplete = false; }
+    if (_topicsComplete) return reply({{u"hasMore"_q, false}, {u"peer"_q, state()}}, {});
+    _topicsReply = std::move(reply); _topicsDeadline.callOnce(12000);
+    _topicsRequest = _api.request(MTPmessages_GetForumTopics(MTP_flags(0), peer()->input(), MTPstring(), MTP_int(_topicOffsetDate), MTP_int(_topicOffsetId), MTP_int(_topicOffsetTopic), MTP_int(100)))
+    .done(crl::guard(this, [=](const MTPmessages_ForumTopics &result) {
+        _topicsRequest = 0; _topicsDeadline.cancel(); auto done = base::take(_topicsReply);
+        if (!_allowed() || !peer() || !peer()->forum()) return done({}, u"LOCKED"_q);
+        auto offset = Data::ForumOffsets{TimeId(_topicOffsetDate), MsgId(_topicOffsetId), MsgId(_topicOffsetTopic)};
+        const auto previous = offset;
+        if (!peer()->forum()->applyReceivedTopics(result, offset)) return done({}, u"TOPICS_UNAVAILABLE"_q);
+        for (const auto &entry : result.data().vtopics().v) {
+            if (entry.type() == mtpc_forumTopic) _topicIds.insert(entry.c_forumTopic().vid().v);
+        }
+        _topicOffsetDate = offset.date; _topicOffsetId = offset.id.bare; _topicOffsetTopic = offset.topicId.bare;
+        _topicsComplete = result.data().vtopics().v.isEmpty() || _topicIds.size() >= result.data().vcount().v || offset == previous;
+        done({{u"peer"_q, state()}, {u"hasMore"_q, !_topicsComplete}}, {});
+    })).fail(crl::guard(this, [=](const MTP::Error &error) {
+        _topicsRequest = 0; _topicsDeadline.cancel();
+        if (auto done = base::take(_topicsReply)) done({}, MTP::IsFloodError(error) ? u"FLOOD_WAIT"_q : u"TOPICS_UNAVAILABLE"_q);
+    })).handleFloodErrors().send();
+}
+void IcqramChat::selectTopic(int id, Reply reply) {
+    const auto selected = peer()->forumTopicFor(MsgId(id));
+    if (!peer()->isForum() || !_topicIds.contains(id) || !selected || selected->dying() || selected->hidden()) return reply({}, u"TOPIC_UNAVAILABLE"_q);
+    const auto transfer = _transfer.value(u"state"_q).toString();
+    if (_sendRequest || _uploadRequest || transfer == u"ready"_q || transfer == u"uploading"_q || transfer == u"sending"_q || transfer == u"uncertain"_q) return reply({}, u"BUSY"_q);
+    if (_typingSent) {
+        _api.request(MTPmessages_SetTyping(MTP_flags(MTPmessages_SetTyping::Flag::f_top_msg_id), peer()->input(), MTP_int(_topicId), MTP_sendMessageCancelAction())).send();
+        _typingSent = false;
+    }
+    _api.request(base::take(_historyRequest)).cancel(); _historyDeadline.cancel();
+    if (auto pending = base::take(_historyReply)) pending({}, u"TOPIC_CHANGED"_q);
+    _knownIncoming.clear();
+    _topicId = id;
+    reply(state(), {});
+}
+QJsonObject IcqramChat::state() {
+	const auto user = peer();
+	const auto person = user->asUser();
+	const auto history = _account->session().data().history(user);
+	const auto selected = topic();
+	const auto painter = selected ? selected->sendActionPainter() : history->sendActionPainter();
+	auto commands = QJsonArray();
+	const auto bot = person ? person->botInfo.get() : nullptr;
+	if (bot) {
+		static const auto validCommand = QRegularExpression(u"^[a-zA-Z0-9_]{1,32}$"_q);
+		for (const auto &command : bot->commands) {
+			if (commands.size() >= 100) break;
+			if (!validCommand.match(command.command).hasMatch()) continue;
+			commands.push_back(QJsonObject{
+				{ u"command"_q, command.command },
+				{ u"description"_q, command.description.left(256) },
+			});
+		}
+	}
+	auto topicList = QJsonArray();
+	for (const auto id : _topicIds) {
+		const auto item = user->forumTopicFor(MsgId(id));
+		if (!item || item->dying() || item->hidden()) continue;
+		topicList.push_back(QJsonObject{{u"id"_q,id},{u"title"_q,item->title()},{u"color"_q,item->colorId()},{u"closed"_q,item->closed()}});
+	}
+	// Expire actions even when the upstream Qt history is not being painted.
+	painter->updateNeedsAnimating(crl::now());
+	auto photoStates = QJsonArray();
+    for (auto i = _photoViews.begin(); i != _photoViews.end(); ++i) {
+        const auto media = i.value(); const auto photo = media->owner();
+        photoStates.push_back(QJsonObject{{u"messageId"_q,i.key()}, {u"state"_q,media->loaded() ? u"done"_q : photo->loading() ? u"loading"_q : u"failed"_q}, {u"bytes"_q,photo->loadOffset()}, {u"size"_q,photo->imageByteSize(Data::PhotoSize::Large)}});
+    }
+    auto transfers = QJsonArray();
+	if (!_transfer.isEmpty()) transfers.push_back(_transfer);
+	for (auto i = _downloads.begin(); i != _downloads.end(); ++i) {
+		auto &download = i.value();
+		const auto document = download.document;
+		if (download.state == u"downloading"_q && !document->loading()) {
+			const auto saved = document->status != FileDownloadFailed
+                && !document->cancelled()
+                && QFileInfo(document->filepath(true)).absoluteFilePath() == QFileInfo(download.path).absoluteFilePath()
+                && QFileInfo(download.path).isFile()
+                && QFileInfo(download.path).size() == document->size;
+            download.state = saved ? u"done"_q : document->cancelled() ? u"cancelled"_q : u"failed"_q;
+		}
+		transfers.push_back(QJsonObject{{u"messageId"_q, i.key()}, {u"direction"_q, u"download"_q}, {u"name"_q, document->filename()}, {u"size"_q, document->size}, {u"bytes"_q, download.state == u"done"_q ? document->size : document->loadOffset()}, {u"state"_q, download.state}});
+	}
+	return {{u"commands"_q, commands}, {u"commandsReady"_q, bot && bot->inited}, {u"id"_q, _peerId}, {u"name"_q, user->name()}, {u"username"_q, user->username()}, {u"bot"_q, user->isBot()}, {u"self"_q, user->isSelf()}, {u"online"_q, person && person->lastseen().isOnline(QDateTime::currentSecsSinceEpoch())}, {u"group"_q,!person && !user->isBroadcast()}, {u"channel"_q,user->isBroadcast()}, {u"forum"_q,user->isForum()}, {u"topicId"_q,_topicId}, {u"topics"_q,topicList}, {u"topicTitle"_q,selected ? selected->title() : QString()}, {u"canSend"_q,canSend()}, {u"canSendFiles"_q,canSend(true)}, {u"blocked"_q, user->isBlocked()}, {u"typing"_q, painter->actionText()}, {u"transfers"_q, transfers}, {u"photos"_q, photoStates}, {u"readOutboxMaxId"_q, history->outboxReadTillId().bare}, {u"readInboxMaxId"_q, selected ? selected->replies()->inboxReadTillId().bare : history->inboxReadTillId().bare}, {u"unread"_q, history->unreadCountKnown() ? history->unreadCount() : 0}};
+}
+void IcqramChat::saveDraft(const QString &text) {
+    const auto history = _account->session().data().history(peer());
+    const auto existing = history->localDraft(MsgId(_topicId), PeerId());
+    if (existing && existing->textWithTags.text == text) return;
+    if (text.isEmpty()) history->clearLocalDraft(MsgId(_topicId), PeerId());
+    else {
+        auto draft = std::make_unique<Data::Draft>();
+        draft->textWithTags.text = text;
+        draft->reply.topicRootId = MsgId(_topicId);
+        history->setLocalDraft(std::move(draft));
+    }
+    _account->session().local().writeDrafts(history);
+}
+void IcqramChat::block(bool blocked, Reply reply) {
+	if (!peer()->asUser() || peer()->isSelf()) return reply({}, u"BLOCK_FAILED"_q);
+	if (_blockRequest) return reply({}, u"BUSY"_q);
+	_blockReply = std::move(reply); _blockDeadline.callOnce(12000);
+	const auto done = crl::guard(this, [=](const MTPBool &result) {
+		_blockRequest = 0; _blockDeadline.cancel(); auto reply = base::take(_blockReply);
+		if (!_allowed()) return reply({}, u"LOCKED"_q);
+		if (result.type() != mtpc_boolTrue) return reply({}, u"BLOCK_FAILED"_q);
+		peer()->setIsBlocked(blocked); reply(state(), {});
+	});
+	const auto fail = crl::guard(this, [=](const MTP::Error &error) { _blockRequest = 0; _blockDeadline.cancel(); if (auto reply = base::take(_blockReply)) reply({}, MTP::IsFloodError(error) ? u"FLOOD_WAIT"_q : u"BLOCK_FAILED"_q); });
+	if (blocked) _blockRequest = _api.request(MTPcontacts_Block(MTP_flags(0), peer()->input())).done(done).fail(fail).handleFloodErrors().send();
+	else _blockRequest = _api.request(MTPcontacts_Unblock(MTP_flags(0), peer()->input())).done(done).fail(fail).handleFloodErrors().send();
+}
+void IcqramChat::chooseFile(Reply reply) {
+	if (!canSend(true)) return reply({}, u"CHAT_READ_ONLY"_q);
+	if (_uploadRequest || peer()->isBlocked()) return reply({}, u"BUSY"_q);
+	const auto path = QFileDialog::getOpenFileName(QApplication::activeWindow(), u"Gönderilecek dosyayı seç"_q);
+	if (!_allowed()) return reply({}, u"LOCKED"_q);
+	if (path.isEmpty()) return reply({{u"cancelled"_q, true}}, {});
+	const auto info = QFileInfo(path);
+	if (!info.isFile() || !info.isReadable() || info.size() <= 0 || info.size() > qint64(2000) * 1024 * 1024) return reply({}, u"INVALID_FILE"_q);
+	_selectedFile = info.canonicalFilePath(); _fileToken = QUuid::createUuid().toString(QUuid::WithoutBraces);
+	_transfer = {{u"direction"_q, u"upload"_q}, {u"token"_q, _fileToken}, {u"state"_q, u"ready"_q}, {u"name"_q, info.fileName()}, {u"size"_q, info.size()}, {u"bytes"_q, 0}};
+	reply({{u"token"_q, _fileToken}, {u"name"_q, info.fileName()}, {u"size"_q, info.size()}}, {});
+}
+void IcqramChat::startFile(const QString &token, Reply reply) {
+	if (!canSend(true)) return reply({}, u"CHAT_READ_ONLY"_q);
+	if (_uploadRequest || peer()->isBlocked()) return reply({}, u"BUSY"_q);
+	if (token.isEmpty() || token != _fileToken || _transfer.value(u"state"_q) != u"ready"_q) return reply({}, u"INVALID_FILE"_q);
+	_uploadFile = std::make_unique<QFile>(_selectedFile);
+	if (!_uploadFile->open(QIODevice::ReadOnly) || _uploadFile->size() != _transfer.value(u"size"_q).toInteger()) return reply({}, u"FILE_CHANGED"_q);
+	_uploadId = base::RandomValue<uint64>(); _fileRandomId = base::RandomValue<uint64>();
+	_part = 0; _parts = int((_uploadFile->size() + 524287) / 524288);
+	_fileHash = std::make_unique<QCryptographicHash>(QCryptographicHash::Md5);
+	_transfer.insert(u"state"_q, u"uploading"_q);
+	uploadPart(); reply({{u"started"_q, true}}, {});
+}
+void IcqramChat::failUpload(QString error) {
+	_uploadDeadline.cancel(); _uploadRequest = 0;
+	if (_uploadFile) _uploadFile->close();
+	_transfer.insert(u"state"_q, _transfer.value(u"state"_q) == u"sending"_q ? u"uncertain"_q : u"failed"_q);
+	_transfer.insert(u"error"_q, error);
+}
+void IcqramChat::uploadPart() {
+	if (!_allowed()) return failUpload(u"LOCKED"_q);
+	if (_part >= _parts) return finishUpload();
+	const auto size = _transfer.value(u"size"_q).toInteger();
+	if (_uploadFile->size() != size) return failUpload(u"FILE_CHANGED"_q);
+	const auto expected = std::min(qint64(524288), size - qint64(_part) * 524288);
+	const auto bytes = _uploadFile->read(expected);
+	if (bytes.size() != expected) return failUpload(u"READ_FAILED"_q);
+	_fileHash->addData(bytes); _uploadDeadline.callOnce(60000);
+	const auto done = crl::guard(this, [=](const MTPBool &result) {
+		_uploadRequest = 0;
+		if (result.type() != mtpc_boolTrue) return failUpload(u"UPLOAD_FAILED"_q);
+		++_part; _transfer.insert(u"bytes"_q, std::min(qint64(_part) * 524288, _uploadFile->size())); uploadPart();
+	});
+	const auto fail = crl::guard(this, [=](const MTP::Error &) { failUpload(u"UPLOAD_FAILED"_q); });
+	if (_uploadFile->size() > 10 * 1024 * 1024) _uploadRequest = _api.request(MTPupload_SaveBigFilePart(MTP_long(_uploadId), MTP_int(_part), MTP_int(_parts), MTP_bytes(bytes))).done(done).fail(fail).handleFloodErrors().send();
+	else _uploadRequest = _api.request(MTPupload_SaveFilePart(MTP_long(_uploadId), MTP_int(_part), MTP_bytes(bytes))).done(done).fail(fail).handleFloodErrors().send();
+}
+void IcqramChat::finishUpload() {
+	if (!canSend(true)) return failUpload(u"CHAT_READ_ONLY"_q);
+	const auto name = QFileInfo(_selectedFile).fileName();
+	const auto file = _uploadFile->size() > 10 * 1024 * 1024
+		? MTPInputFile(MTP_inputFileBig(MTP_long(_uploadId), MTP_int(_parts), MTP_string(name)))
+		: MTPInputFile(MTP_inputFile(MTP_long(_uploadId), MTP_int(_parts), MTP_string(name), MTP_string(QString::fromLatin1(_fileHash->result().toHex()))));
+	_uploadFile->close();
+	const auto media = MTP_inputMediaUploadedDocument(MTP_flags(MTPDinputMediaUploadedDocument::Flag::f_force_file), file, MTPInputFile(), MTP_string(QMimeDatabase().mimeTypeForFile(name, QMimeDatabase::MatchExtension).name()), MTP_vector<MTPDocumentAttribute>(1, MTP_documentAttributeFilename(MTP_string(name))), MTPVector<MTPInputDocument>(), MTPInputPhoto(), MTPint(), MTPint());
+	_transfer.insert(u"state"_q, u"sending"_q); _uploadDeadline.callOnce(30000);
+	_uploadRequest = _api.request(MTPmessages_SendMedia(MTP_flags(_topicId > 1 ? MTPmessages_SendMedia::Flag::f_reply_to : MTPmessages_SendMedia::Flag()), peer()->input(), replyTo(), media, MTP_string(QString()), MTP_long(_fileRandomId), MTPReplyMarkup(), MTPVector<MTPMessageEntity>(), MTPint(), MTPint(), MTPInputPeer(), MTPInputQuickReplyShortcut(), MTPlong(), MTPlong(), MTPSuggestedPost()))
+	.done(crl::guard(this, [=](const MTPUpdates &updates) {
+		_uploadRequest = 0; _uploadDeadline.cancel();
+		if (!_account->sessionExists()) return failUpload(u"LOCKED"_q);
+		_account->session().api().applyUpdates(updates); _transfer.insert(u"state"_q, u"done"_q);
+	})).fail(crl::guard(this, [=](const MTP::Error &) { failUpload(u"SEND_UNCERTAIN"_q); })).handleFloodErrors().send();
+}
+void IcqramChat::download(int messageId, Reply reply) {
+	const auto document = _documents.value(messageId);
+	if (!document || document->forbidsFileSave()) return reply({}, u"FILE_UNAVAILABLE"_q);
+	if (document->loading()) return reply({}, u"BUSY"_q);
+	const auto name = QFileInfo(document->filename()).fileName();
+	const auto path = QFileDialog::getSaveFileName(QApplication::activeWindow(), u"Dosyayı kaydet"_q, QDir(QStandardPaths::writableLocation(QStandardPaths::DownloadLocation)).filePath(name.isEmpty() ? u"dosya"_q : name));
+	if (!_allowed()) return reply({}, u"LOCKED"_q);
+	if (path.isEmpty()) return reply({{u"cancelled"_q, true}}, {});
+	_downloads[messageId] = {document, path, u"downloading"_q};
+	document->save(Data::FileOrigin(FullMsgId(peer()->id, MsgId(messageId))), path);
+	reply({{u"started"_q, true}}, {});
+}
+QString IcqramChat::mediaMime(int messageId) const {
+	const auto document = _documents.value(messageId);
+	if (!peer() || !peer()->allowsForwarding()) return {};
+	if (!document || document->forbidsFileSave() || document->size <= 0
+		|| document->size > qint64(2000) * 1024 * 1024
+		|| !(document->isVideoFile() || document->isVideoMessage()
+			|| document->isAudioFile() || document->isVoiceMessage())) {
+		return {};
+	}
+	const auto mime = document->mimeString().toLower();
+	static const auto allowed = QSet<QString>{
+		u"video/mp4"_q, u"video/quicktime"_q, u"video/webm"_q,
+		u"audio/mpeg"_q, u"audio/mp4"_q, u"audio/aac"_q,
+		u"audio/ogg"_q, u"audio/opus"_q, u"audio/wav"_q,
+		u"audio/x-wav"_q, u"audio/flac"_q, u"audio/webm"_q,
+	};
+	return allowed.contains(mime) ? mime : QString();
+}
+
+bool IcqramChat::canViewMedia(int messageId) const {
+	return _photos.contains(messageId) || !mediaMime(messageId).isEmpty();
+}
+
+void IcqramChat::cancelMedia(int messageId) {
+	if (_photoViews.contains(messageId)) _photoViews[messageId]->owner()->cancel();
+	if (messageId != _playbackId) return;
+	if (_mediaDocument && _mediaDirectory && _mediaDocument->loading()
+		&& _mediaDocument->loadingFilePath() == _mediaDirectory->filePath(u"media"_q)) {
+		_mediaDocument->cancel();
+	}
+	_mediaDocument = nullptr;
+	_playbackId = 0;
+	_playbackStarted = false;
+	_mediaDirectory.reset();
+}
+
+IcqramChat::MediaChunk IcqramChat::mediaChunk(int messageId, qint64 offset, qint64 limit) {
+	if (!_allowed() || messageId != _playbackId || !_mediaDirectory
+		|| mediaMime(messageId).isEmpty() || !_mediaDocument
+		|| _mediaDocument->loading()) return {};
+	auto file = QFile(_mediaDirectory->filePath(u"media"_q));
+	if (!file.open(QIODevice::ReadOnly) || file.size() != _mediaDocument->size
+		|| offset < 0 || offset >= file.size() || !file.seek(offset)) return {};
+	const auto count = std::min(qint64(2 * 1024 * 1024),
+		limit > 0 ? limit : file.size() - offset);
+	return { file.read(count), mediaMime(messageId), file.size() };
+}
+
+void IcqramChat::media(int messageId, bool save, Reply reply) {
+	if (_photos.contains(messageId)) return photo(messageId, save, std::move(reply));
+	const auto document = _documents.value(messageId);
+	const auto mime = mediaMime(messageId);
+	if (mime.isEmpty() || !document || document->size <= 0
+		|| document->size > qint64(2000) * 1024 * 1024) {
+		return reply({}, u"FILE_UNAVAILABLE"_q);
+	}
+	if (_playbackId != messageId) {
+		cancelMedia(_playbackId);
+		if (save) return reply({}, u"MEDIA_NOT_READY"_q);
+		_mediaDirectory = std::make_unique<QTemporaryDir>(QDir::tempPath() + u"/icqram-media-XXXXXX"_q);
+		if (!_mediaDirectory->isValid()) return reply({}, u"FILE_UNAVAILABLE"_q);
+		_playbackId = messageId;
+		_mediaDocument = document;
+	}
+	const auto path = _mediaDirectory->filePath(u"media"_q);
+	const auto complete = !document->loading() && QFileInfo(path).isFile()
+		&& QFileInfo(path).size() == document->size && document->status != FileDownloadFailed;
+	if (!complete) {
+		if (save) return reply({}, u"MEDIA_NOT_READY"_q);
+		if (!document->loading()) {
+			if (_playbackStarted) return reply({}, u"FILE_LOAD_FAILED"_q);
+			const auto storage = QStorageInfo(_mediaDirectory->path());
+			if (storage.isValid() && storage.bytesAvailable() < document->size + 16 * 1024 * 1024) {
+				return reply({}, u"DISK_FULL"_q);
+			}
+			_playbackStarted = true;
+			document->save(Data::FileOrigin(FullMsgId(peer()->id, MsgId(messageId))), path);
+		}
+		return reply({{u"loading"_q,true}, {u"bytes"_q,document->loadOffset()}, {u"size"_q,document->size}}, {});
+	}
+	if (save) {
+		const auto name = QFileInfo(document->filename()).fileName();
+		const auto target = QFileDialog::getSaveFileName(QApplication::activeWindow(),
+			u"Medyayı kaydet"_q, QDir(QStandardPaths::writableLocation(QStandardPaths::DownloadLocation)).filePath(
+				name.isEmpty() ? (document->isVoiceMessage() ? u"sesli-mesaj.ogg"_q : u"medya"_q) : name));
+		if (!_allowed()) return reply({},u"LOCKED"_q);
+		if (target.isEmpty()) return reply({{u"cancelled"_q,true}},{});
+		auto input = QFile(path);
+		auto output = QSaveFile(target);
+		if (!input.open(QIODevice::ReadOnly) || !output.open(QIODevice::WriteOnly)) return reply({},u"FILE_SAVE_FAILED"_q);
+		while (!input.atEnd()) {
+			const auto chunk = input.read(1024 * 1024);
+			if (chunk.isEmpty() || output.write(chunk) != chunk.size()) return reply({},u"FILE_SAVE_FAILED"_q);
+		}
+		return output.commit() ? reply({{u"saved"_q,true}}, {}) : reply({},u"FILE_SAVE_FAILED"_q);
+	}
+	reply({{u"url"_q,u"icqram-ui://domain/media/playback"_q},
+		{u"kind"_q,(document->isVideoFile() || document->isVideoMessage()) ? u"video"_q : u"audio"_q},
+		{u"mime"_q,mime}, {u"name"_q,document->filename()},
+		{u"size"_q,document->size}}, {});
+}
+void IcqramChat::photo(int messageId, bool save, Reply reply) {
+    const auto photo = _photos.value(messageId);
+    if (!peer()->allowsForwarding()) return reply({}, u"FILE_UNAVAILABLE"_q);
+    if (!photo || photo->imageByteSize(Data::PhotoSize::Large) > 32 * 1024 * 1024) return reply({}, u"FILE_UNAVAILABLE"_q);
+    if (!_photoViews.contains(messageId) && _photoViews.size() >= 32) return reply({}, u"MEDIA_LIMIT"_q);
+    auto &media = _photoViews[messageId];
+    if (!media || media->owner() != photo) media = photo->createMediaView();
+    if (!media->loaded()) {
+        if (save) return reply({}, u"MEDIA_NOT_READY"_q);
+        if (!photo->loading()) media->wanted(Data::PhotoSize::Large, Data::FileOrigin(FullMsgId(peer()->id,MsgId(messageId))));
+        return reply({{u"loading"_q,true}, {u"bytes"_q,photo->loadOffset()}, {u"size"_q,photo->imageByteSize(Data::PhotoSize::Large)}}, {});
+    }
+    if (save) {
+        const auto name = u"icqram-photo-"_q + QString::number(messageId) + u".jpg"_q;
+        const auto path = QFileDialog::getSaveFileName(QApplication::activeWindow(),u"Fotoğrafı kaydet"_q,QDir(QStandardPaths::writableLocation(QStandardPaths::DownloadLocation)).filePath(name),u"JPEG (*.jpg *.jpeg)"_q);
+        if (!_allowed()) return reply({},u"LOCKED"_q);
+        if (path.isEmpty()) return reply({{u"cancelled"_q,true}},{});
+        return media->saveToFile(path) ? reply({{u"saved"_q,true}}, {}) : reply({},u"FILE_SAVE_FAILED"_q);
+    }
+    const auto image = media->image(Data::PhotoSize::Large);
+    if (!image) return reply({},u"FILE_UNAVAILABLE"_q);
+    auto bytes = QByteArray(); auto buffer = QBuffer(&bytes); buffer.open(QIODevice::WriteOnly);
+    image->original().scaled(1280,1280,Qt::KeepAspectRatio,Qt::SmoothTransformation).save(&buffer,"JPG",80);
+    reply({{u"url"_q,u"data:image/jpeg;base64,"_q+QString::fromLatin1(bytes.toBase64())}, {u"width"_q,image->original().width()}, {u"height"_q,image->original().height()}},{});
+}
+void IcqramChat::request(const QString &method, const QJsonObject &params, Reply reply) {
+	if (!_allowed()) return reply({}, u"LOCKED"_q);
+	if (!peer()) return reply({}, u"PEER_UNAVAILABLE"_q);
+	if (method == u"chat.commands.refresh"_q) {
+		if (!peer()->isBot()) return reply({}, u"INVALID_REQUEST"_q);
+		_account->session().api().requestFullPeer(peer());
+		return reply(state(), {});
+	}
+	if (method == u"chat.topics"_q) return topics(params.value(u"reset"_q).toBool(), std::move(reply));
+    if (method == u"chat.topic.select"_q) return selectTopic(params.value(u"topicId"_q).toInt(), std::move(reply));
+    // Every topic-dependent action carries its context, so delayed UI work cannot target a different topic.
+    if ((method == u"chat.history"_q || method == u"chat.send"_q || method.startsWith(u"chat.draft."_q) || method == u"chat.read"_q || method == u"chat.typing"_q || method == u"chat.file.choose"_q || method == u"chat.file.send"_q)
+        && params.value(u"topicId"_q).toInt() != _topicId) return reply({}, u"TOPIC_CHANGED"_q);
+    if (method == u"chat.history"_q) {
+		const auto before = params.value(u"before"_q).toInt();
+		if (before < 0) return reply({}, u"INVALID_REQUEST"_q);
+		history(before, std::move(reply));
+	} else if (method == u"chat.send"_q) {
+		send(params, std::move(reply));
+	} else if (method == u"chat.draft.get"_q) {
+        const auto history = _account->session().data().history(peer());
+        const auto draft = history->localDraft(MsgId(_topicId), PeerId());
+        reply({{u"text"_q, draft ? draft->textWithTags.text : QString()}}, {});
+    } else if (method == u"chat.draft.set"_q) {
+        if (!params.value(u"text"_q).isString() || params.value(u"text"_q).toString().size() > 4000) return reply({}, u"INVALID_MESSAGE"_q);
+        saveDraft(params.value(u"text"_q).toString());
+        reply({{u"saved"_q, true}}, {});
+    } else if (method == u"chat.read"_q) {
+        const auto id = params.value(u"messageId"_q).toInt();
+        if (!_knownIncoming.contains(id)) return reply({}, u"INVALID_MESSAGE"_q);
+        if (const auto selected = topic()) selected->replies()->readTill(MsgId(id));
+        else if (!peer()->isForum()) _account->session().data().histories().readInboxTill(_account->session().data().history(peer()), MsgId(id));
+        reply({{u"accepted"_q, true}}, {});
+    } else if (method == u"chat.state"_q) {
+		reply(state(), {});
+	} else if (method == u"chat.block"_q && params.value(u"blocked"_q).isBool()) {
+		block(params.value(u"blocked"_q).toBool(), std::move(reply));
+	} else if (method == u"chat.typing"_q) {
+		const auto active = params.value(u"active"_q).toBool();
+		if (canSend() && !peer()->isBroadcast() && !peer()->isSelf() && !peer()->isBot() && !peer()->isBlocked() && (!active || crl::now() - _typingSentAt > 4500) && (active || _typingSent)) {
+			_typingSent = active; _typingSentAt = crl::now();
+			_api.request(MTPmessages_SetTyping(MTP_flags(_topicId ? MTPmessages_SetTyping::Flag::f_top_msg_id : MTPmessages_SetTyping::Flag()), peer()->input(), MTP_int(_topicId), active ? MTPSendMessageAction(MTP_sendMessageTypingAction()) : MTPSendMessageAction(MTP_sendMessageCancelAction()))).send();
+		}
+		reply({{u"ok"_q, true}}, {});
+	} else if (method == u"chat.media.get"_q || method == u"chat.media.save"_q) {
+		media(params.value(u"messageId"_q).toInt(), method == u"chat.media.save"_q, std::move(reply));
+	} else if (method == u"chat.media.cancel"_q) {
+		cancelMedia(params.value(u"messageId"_q).toInt());
+		reply({{u"cancelled"_q,true}},{});
+	} else if (method == u"chat.photo.get"_q || method == u"chat.photo.save"_q) {
+        photo(params.value(u"messageId"_q).toInt(), method == u"chat.photo.save"_q, std::move(reply));
+    } else if (method == u"chat.photo.cancel"_q) {
+        const auto id = params.value(u"messageId"_q).toInt();
+        if (_photoViews.contains(id)) _photoViews[id]->owner()->cancel();
+        reply({{u"cancelled"_q,true}},{});
+    } else if (method == u"chat.file.choose"_q) {
+		chooseFile(std::move(reply));
+	} else if (method == u"chat.file.send"_q) {
+		startFile(params.value(u"token"_q).toString(), std::move(reply));
+	} else if (method == u"chat.file.download"_q) {
+		download(params.value(u"messageId"_q).toInt(), std::move(reply));
+	} else if (method == u"chat.file.cancel"_q) {
+		const auto messageId = params.value(u"messageId"_q).toInt();
+		if (messageId && _downloads.contains(messageId)) {
+			_downloads[messageId].document->cancel(); _downloads[messageId].state = u"cancelled"_q;
+		} else if (!messageId) {
+			_api.request(base::take(_uploadRequest)).cancel(); _uploadDeadline.cancel();
+			const auto uncertain = _transfer.value(u"state"_q) == u"sending"_q;
+			if (_uploadFile) _uploadFile->close(); _transfer.insert(u"state"_q, uncertain ? u"uncertain"_q : u"cancelled"_q);
+		}
+		reply(state(), {});
+	} else {
+		reply({}, u"UNSUPPORTED_METHOD"_q);
+	}
+}
+void IcqramChat::history(int before, Reply reply) {
+	if (_historyRequest) return reply({}, u"BUSY"_q);
+	_historyReply = std::move(reply);
+	_historyDeadline.callOnce(12000);
+	const auto onDone = crl::guard(this, [=](const MTPmessages_Messages &result) {
+		_historyRequest = 0;
+		_historyDeadline.cancel();
+		auto done = base::take(_historyReply);
+		if (!_allowed() || !peer()) return done({}, u"LOCKED"_q);
+		auto messages = QJsonArray();
+		auto count = 0;
+		auto oldest = 0;
+		const auto consume = [&](const auto &data) {
+			_account->session().data().processUsers(data.vusers());
+			_account->session().data().processChats(data.vchats());
+			for (const auto &message : data.vmessages().v) {
+				++count;
+				message.match([&](const MTPDmessage &m) {
+					const auto id = m.vid().v;
+					if (!m.is_out()) _knownIncoming.insert(id);
+					oldest = oldest ? std::min(oldest, id) : id;
+					auto text = qs(m.vmessage());
+					auto item = QJsonObject{{u"id"_q, id}, {u"date"_q, m.vdate().v}, {u"out"_q, m.is_out()}, {u"text"_q, text}};
+					const auto sender = m.vfrom_id() ? _account->session().data().peerLoaded(peerFromMTP(*m.vfrom_id())) : peer();
+					item.insert(u"sender"_q,sender ? sender->name() : peer()->name());
+					auto commands = QJsonArray();
+					if (m.ventities()) for (const auto &entity : m.ventities()->v) {
+						if (entity.type() != mtpc_messageEntityBotCommand) continue;
+						const auto &command = entity.c_messageEntityBotCommand();
+						commands.push_back(QJsonObject{{u"offset"_q, command.voffset().v}, {u"length"_q, command.vlength().v}});
+					}
+					item.insert(u"commands"_q, commands);
+					_documents.remove(id); _photos.remove(id);
+					if (peer()->allowsForwarding() && !m.is_noforwards() && m.vmedia() && m.vmedia()->type() == mtpc_messageMediaDocument && m.vmedia()->c_messageMediaDocument().vdocument() && m.vmedia()->c_messageMediaDocument().vdocument()->type() == mtpc_document && !m.vmedia()->c_messageMediaDocument().vttl_seconds()) {
+						const auto document = _account->session().data().processDocument(*m.vmedia()->c_messageMediaDocument().vdocument());
+						_documents[id] = document;
+						item.insert(u"file"_q, QJsonObject{{u"name"_q, document->filename()}, {u"size"_q, document->size}, {u"playable"_q,!mediaMime(id).isEmpty()}, {u"kind"_q, document->isVoiceMessage() ? u"voice"_q : (document->isVideoFile() || document->isVideoMessage()) ? u"video"_q : document->isAudioFile() ? u"audio"_q : u"file"_q}});
+					 } else if (peer()->allowsForwarding() && !m.is_noforwards() && m.vmedia() && m.vmedia()->type() == mtpc_messageMediaPhoto && m.vmedia()->c_messageMediaPhoto().vphoto() && m.vmedia()->c_messageMediaPhoto().vphoto()->type() == mtpc_photo && !m.vmedia()->c_messageMediaPhoto().vttl_seconds()) {
+                        _photos[id] = _account->session().data().processPhoto(*m.vmedia()->c_messageMediaPhoto().vphoto());
+                        item.insert(u"photo"_q,true);
+                    } else if (m.vmedia() && m.vmedia()->type() != mtpc_messageMediaEmpty && m.vmedia()->type() != mtpc_messageMediaWebPage) {
+						text += (text.isEmpty() ? QString() : u"\n"_q) + u"[Ek — Telegram’da görüntüleyebilirsin]"_q;
+					}
+					item.insert(u"text"_q, text); messages.push_back(item);
+				}, [&](const MTPDmessageService &m) {
+					const auto id = m.vid().v;
+					if (!m.is_out()) _knownIncoming.insert(id);
+					oldest = oldest ? std::min(oldest, id) : id;
+					messages.push_back(QJsonObject{{u"id"_q, id}, {u"date"_q, m.vdate().v}, {u"out"_q, m.is_out()}, {u"text"_q, u"Telegram hizmet bildirimi"_q}});
+				}, [&](const MTPDmessageEmpty &m) {
+					oldest = oldest ? std::min(oldest, m.vid().v) : m.vid().v;
+				});
+			}
+		};
+		result.match([&](const MTPDmessages_messages &d) { consume(d); }, [&](const MTPDmessages_messagesSlice &d) { consume(d); }, [&](const MTPDmessages_channelMessages &d) { consume(d); }, [&](const MTPDmessages_messagesNotModified &) {});
+		const auto user = peer();
+		user->loadUserpic();
+		_awaitingPhoto = user->hasUserpic() && user->useEmptyUserpic(_userpic);
+		auto bytes = QByteArray();
+		auto buffer = QBuffer(&bytes);
+		buffer.open(QIODevice::WriteOnly);
+		const auto avatar = PeerData::GenerateUserpicImage(user, _userpic, 64, 0);
+		avatar.save(&buffer, "PNG");
+		const auto avatarUrl = u"data:image/png;base64,"_q + QString::fromLatin1(bytes.toBase64());
+		auto peerState = state(); peerState.insert(u"avatar"_q, avatarUrl);
+		done({{u"messages"_q, messages}, {u"oldest"_q, oldest}, {u"hasMore"_q, count == 50}, {u"peer"_q, peerState}}, {});
+	});
+	const auto onFail = crl::guard(this, [=](const MTP::Error &error) {
+		_historyRequest = 0;
+		_historyDeadline.cancel();
+		if (auto done = base::take(_historyReply)) done({}, MTP::IsFloodError(error) ? u"FLOOD_WAIT"_q : u"HISTORY_UNAVAILABLE"_q);
+	});
+    if (peer()->isForum() && !_topicId) {
+        _historyDeadline.cancel(); auto done = base::take(_historyReply);
+        return done({{u"messages"_q,QJsonArray()}, {u"oldest"_q,0}, {u"hasMore"_q,false}, {u"peer"_q,state()}}, {});
+    }
+    if (_topicId) _historyRequest = _api.request(MTPmessages_GetReplies(peer()->input(), MTP_int(_topicId), MTP_int(before), MTP_int(0), MTP_int(0), MTP_int(50), MTP_int(0), MTP_int(0), MTP_long(0))).done(onDone).fail(onFail).handleFloodErrors().send();
+    else _historyRequest = _api.request(MTPmessages_GetHistory(peer()->input(), MTP_int(before), MTP_int(0), MTP_int(0), MTP_int(50), MTP_int(0), MTP_int(0), MTP_long(0))).done(onDone).fail(onFail).handleFloodErrors().send();
+}
+void IcqramChat::send(const QJsonObject &params, Reply reply) {
+	if (!canSend()) return reply({}, u"CHAT_READ_ONLY"_q);
+	if (peer()->isBlocked()) return reply({}, u"PEER_BLOCKED"_q);
+	if (_sendRequest) return reply({}, u"BUSY"_q);
+	if (crl::now() < _retrySendAt) return reply({}, u"FLOOD_WAIT"_q);
+	const auto text = params.value(u"text"_q).toString();
+	const auto nonce = params.value(u"nonce"_q).toString();
+	static const auto validNonce = QRegularExpression(u"^[a-zA-Z0-9-]{16,64}$"_q);
+	if (text.trimmed().isEmpty() || text.size() > 4000 || !validNonce.match(nonce).hasMatch()) return reply({}, u"INVALID_MESSAGE"_q);
+	if (!_attempts.contains(nonce)) {
+		if (_attempts.size() >= 2048) return reply({}, u"SESSION_SEND_LIMIT"_q);
+		_attempts.insert(nonce, Attempt{ text, base::RandomValue<uint64>(), {}, _topicId });
+	}
+	const auto &attempt = _attempts[nonce];
+	if (attempt.text != text || attempt.topicId != _topicId) return reply({}, u"NONCE_CONFLICT"_q);
+	if (!attempt.result.isEmpty()) return reply(attempt.result, {});
+	_sendReply = std::move(reply);
+	_sendDeadline.callOnce(12000);
+	// The same nonce always reuses Telegram's random_id, including timeout retries.
+	_sendRequest = _api.request(MTPmessages_SendMessage(
+		MTP_flags(MTPmessages_SendMessage::Flag::f_no_webpage | (_topicId > 1 ? MTPmessages_SendMessage::Flag::f_reply_to : MTPmessages_SendMessage::Flag())), peer()->input(), replyTo(), MTP_string(text), MTP_long(attempt.randomId), MTPReplyMarkup(), MTPVector<MTPMessageEntity>(), MTPint(), MTPint(), MTPInputPeer(), MTPInputQuickReplyShortcut(), MTPlong(), MTPlong(), MTPSuggestedPost(), MTPInputRichMessage()))
+	.done(crl::guard(this, [=](const MTPUpdates &updates) {
+		_sendRequest = 0;
+		_sendDeadline.cancel();
+		auto done = base::take(_sendReply);
+		if (!_account->sessionExists()) return done({}, u"LOCKED"_q);
+		auto result = QJsonObject{{u"sent"_q, true}};
+		if (updates.type() == mtpc_updateShortSentMessage) result.insert(u"id"_q, updates.c_updateShortSentMessage().vid().v);
+		_attempts[nonce].result = result;
+        if (!params.value(u"preserveDraft"_q).toBool()) {
+            const auto draft = _account->session().data().history(peer())->localDraft(MsgId(_topicId), PeerId());
+            if (draft && draft->textWithTags.text.trimmed() == text) saveDraft(QString());
+        }
+		_account->session().api().applyUpdates(updates);
+		done(_allowed() ? result : QJsonObject(), _allowed() ? QString() : u"SEND_UNCERTAIN"_q);
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_sendRequest = 0;
+		_sendDeadline.cancel();
+		if (MTP::IsFloodError(error)) {
+			const auto seconds = error.type().section('_', -1).toInt();
+			_retrySendAt = crl::now() + std::clamp(seconds, 30, 86400) * crl::time(1000);
+		}
+		if (auto done = base::take(_sendReply)) done({}, MTP::IsFloodError(error) ? u"FLOOD_WAIT"_q : (error.type() == u"RANDOM_ID_DUPLICATE"_q ? u"SEND_UNCERTAIN"_q : u"SEND_FAILED"_q));
+	})).handleFloodErrors().send();
+}
+}
