+				if (!profile) profile = std::make_unique<IcqramShell>(nullptr, _account, _controller, u"profile"_q);
+				profile->focus();
+			});
+			return sendReply(id, {{u"ok"_q, true}});
+		} else if (method == u"bootstrap"_q) {
+			reply.insert(u"result"_q, _account->sessionExists()
+				? QJsonObject{{u"auth"_q, u"ready"_q}, {u"connected"_q, _account->mtp().dcstate() == MTP::ConnectedState}}
+				: (_auth ? _auth->state() : QJsonObject{{u"auth"_q, u"phone"_q}, {u"connected"_q, false}}));
+		} else if (method == u"window.openMedia"_q && _chatApi && !_mediaId && _account->sessionExists()) {
+            const auto messageId = params.value(u"messageId"_q).toInt();
+            if (!_chatApi->canViewMedia(messageId)) return sendReply(id, {}, u"FILE_UNAVAILABLE"_q);
+            InvokeQueued(this, [=] {
+                if (_locked || Core::App().passcodeLocked() || !_account->sessionExists()) return;
+                if (!_viewer || _viewer->_mediaId != messageId) _viewer = std::make_unique<IcqramShell>(nullptr, _account, _controller, _peerId, messageId, _chatApi.get());
+                _viewer->focus();
+            });
+            return sendReply(id, {{u"ok"_q,true}});
+        } else if (_mediaId && _mediaApi && _account->sessionExists() && (method == u"viewer.load"_q || method == u"viewer.save"_q || method == u"viewer.cancel"_q)) {
+            const auto target = method == u"viewer.load"_q ? u"chat.media.get"_q : method == u"viewer.save"_q ? u"chat.media.save"_q : u"chat.media.cancel"_q;
+            _mediaApi->request(target, {{u"messageId"_q,_mediaId}}, crl::guard(this, [=](QJsonObject result, QString error) {sendReply(id,std::move(result),std::move(error));}));
+            return;
+        } else if (method.startsWith(u"chat."_q) && _chatApi && _account->sessionExists()) {
+            if (method == u"chat.read"_q && (!isVisible() || isMinimized() || !isActiveWindow())) return sendReply(id, {}, u"NOT_VISIBLE"_q);
+			_chatApi->request(method, params, crl::guard(this, [=](QJsonObject result, QString error) {
+				sendReply(id, std::move(result), std::move(error));
+			}));
+			return;
+		} else if (method == u"window.openDirectory"_q && _peerId.isEmpty() && _account->sessionExists()) {
+			InvokeQueued(this, [=] {
+				if (_locked || Core::App().passcodeLocked() || !_account->sessionExists()) return;
+				auto &directory = _chats[u"directory"_q];
+				if (!directory) directory = std::make_unique<IcqramShell>(nullptr, _account, _controller, u"directory"_q);
+				directory->focus();
+			});
+			reply.insert(u"result"_q, QJsonObject{{u"ok"_q, true}});
+		} else if (method == u"window.openChat"_q && (_peerId.isEmpty() || _peerId == u"directory"_q) && _account->sessionExists()) {
+			const auto peerId = params.value(u"contactId"_q).toString();
+			const auto parsedId = Api::IcqramPeerId(peerId);
+			const auto peer = parsedId ? _account->session().data().peerLoaded(parsedId) : nullptr;
+			if (!peer) return sendReply(id, {}, u"PEER_UNAVAILABLE"_q);
+			if (const auto user = peer->asUser()) {
+				if (user->isInaccessible() || (!user->accessHash() && !user->isSelf())) return sendReply(id, {}, u"PEER_UNAVAILABLE"_q);
+			} else if (const auto chat = peer->asChat()) {
+				if (!chat->amIn()) return sendReply(id, {}, u"PEER_UNAVAILABLE"_q);
+			} else if (const auto channel = peer->asChannel()) {
+				if (!channel->amIn()) return sendReply(id, {}, u"PEER_UNAVAILABLE"_q);
+			} else return sendReply(id, {}, u"PEER_UNAVAILABLE"_q);
+			auto owner = this;
+			for (const auto widget : QApplication::topLevelWidgets()) {
+				const auto shell = dynamic_cast<IcqramShell*>(widget);
+				if (shell && shell->_peerId.isEmpty() && shell->_account == _account) { owner = shell; break; }
+			}
+			if (!owner->_chats.contains(peerId) && owner->_chats.size() >= 17) return sendReply(id, {}, u"TOO_MANY_WINDOWS"_q);
+			InvokeQueued(owner, [=] {
+				if (owner->_locked || Core::App().passcodeLocked() || !owner->_account->sessionExists()) return;
+				auto &chat = owner->_chats[peerId];
+				if (!chat) {
+					chat = std::make_unique<IcqramShell>(nullptr, owner->_account, owner->_controller, peerId);
+				}
+				chat->focus();
+			});
+			reply.insert(u"result"_q, QJsonObject{{u"ok"_q, true}});
+		} else if (method == u"preferences.theme"_q) {
+			const auto theme = params.value(u"theme"_q).toString();
+			if (theme != u"system"_q && theme != u"light"_q && theme != u"dark"_q) return sendReply(id, {}, u"INVALID_REQUEST"_q);
+			const auto json = QJsonDocument(QJsonObject{{u"theme"_q, theme}}).toJson(QJsonDocument::Compact);
+			for (const auto widget : QApplication::topLevelWidgets()) {
+				if (const auto shell = dynamic_cast<IcqramShell*>(widget)) shell->_webview->eval("window.dispatchEvent(new CustomEvent('icqram-theme',{detail:" + json + "}));");
+			}
+			reply.insert(u"result"_q, QJsonObject{{u"ok"_q, true}});
+		} else if (method == u"presence.local"_q && (_peerId.isEmpty() || _peerId == u"presence"_q) && _account->sessionExists()) {
+			static const auto validCode = QRegularExpression(u"^(AV|FC|AW|NA|OC|DND|IV|OF|PH|LC)$"_q);
+			const auto code = params.value(u"code"_q).toString();
+			if (!validCode.match(code).hasMatch()) return sendReply(id, {}, u"INVALID_REQUEST"_q);
+            auto settings=QSettings(u"icqram"_q,u"icqram"_q);
+            settings.setValue(u"accounts/"_q + QString::number(_account->session().userId().bare) + u"/presence"_q,code);
+            if (code == u"DND"_q && Notifications::IcqramPreferences().value(u"pauseInDnd"_q).toBool()) Core::App().notifications().clearAll();
+            settings.sync();
+            if(settings.status()!=QSettings::NoError)return sendReply(id,{},u"SAVE_FAILED"_q);
+            const auto data=QJsonDocument(QJsonObject{{u"code"_q,code}}).toJson(QJsonDocument::Compact);
+            for(const auto widget:QApplication::topLevelWidgets()) {
+                const auto shell=dynamic_cast<IcqramShell*>(widget);
+                if(!shell || shell->_account!=_account || shell->_peerId==u"now"_q)continue;
+                shell->_presenceCode=code;
+                shell->_webview->eval("document.dispatchEvent(new CustomEvent('icqram-presence-changed',{detail:"+data+"}));");
+            }
+			reply.insert(u"result"_q, QJsonObject{{u"ok"_q, true}});
+		} else if (method == u"auth.qr"_q) {
+			return sendReply(id, {}, u"QR_UNAVAILABLE"_q);
+		} else if (method.startsWith(u"auth."_q) && _auth) {
+			_auth->request(method, params, crl::guard(this, [=](QJsonObject result, QString error) {
+				sendReply(id, std::move(result), std::move(error));
+			}));
+			return;
+		} else if (method == u"account.logout"_q && _account->sessionExists()) {
+			sendReply(id, {{u"ok"_q, true}});
+			InvokeQueued(this, [=] { _account->logOut(); });
+			return;
+		} else if ((method == u"contacts.load"_q || method == u"dialogs.load"_q || method == u"contacts.snapshot"_q || method == u"profile.load"_q || method == u"presence.set"_q || (method.startsWith(u"directory."_q) && _peerId == u"directory"_q)) && _account->sessionExists()) {
+            auto api=_accountApi.get();
+            if(method==u"presence.set"_q)for(const auto widget:QApplication::topLevelWidgets()) {
+                const auto shell=dynamic_cast<IcqramShell*>(widget);
+                if(shell && shell->_account==_account && shell->_peerId.isEmpty()){api=shell->_accountApi.get();break;}
+            }
+			api->request(method, params, crl::guard(this, [=](QJsonObject result, QString error) {
+				if (method == u"directory.add"_q && result.value(u"added"_q).toBool()) {
+					for (const auto widget : QApplication::topLevelWidgets()) {
+						if (const auto shell = dynamic_cast<IcqramShell*>(widget); shell && shell->_peerId.isEmpty()) shell->_webview->eval("document.dispatchEvent(new Event('icqram-refresh-contacts'));");
+					}
+				}
+				if (method == u"presence.set"_q && error.isEmpty()) {
+					for (const auto widget : QApplication::topLevelWidgets()) {
+						const auto shell = dynamic_cast<IcqramShell*>(widget);
+						if (shell && shell != this && shell->_account == _account && (shell->_peerId.isEmpty() || shell->_peerId == u"profile"_q || shell->_peerId == u"settings"_q || shell->_peerId == u"presence"_q)) shell->_webview->eval("document.dispatchEvent(new Event('icqram-refresh-profile'));");
+					}
+				}
+				sendReply(id, std::move(result), std::move(error));
+			}));
+			return;
+		} else if (method == u"window.resize"_q
+			|| method == u"window.close"_q
+			|| method == u"window.minimize"_q
+			|| method == u"window.dragStart"_q
+			|| method == u"window.dragMove"_q
+			|| method == u"window.dragEnd"_q) {
+			if (method == u"window.resize"_q) {
+				const auto width = params.value(u"width"_q).toInt();
+				const auto height = params.value(u"height"_q).toInt();
+				if (_mediaId) {
+                    setFixedSize(640,520);
+                } else if (_peerId == u"now"_q) {
+					resize(std::clamp(width, 500, 1400), std::clamp(height, 400, 1100));
+				} else if (_peerId == u"directory"_q) {
+					resize(std::clamp(width, 456, 1000), std::clamp(height, 437, 900));
+				} else if (!_peerId.isEmpty()) {
+					resize(std::clamp(width, 476, 1200), std::clamp(height, 267, 900));
+				} else if (width >= 200 && width <= 900 && height >= 100 && height <= 1000) {
+					auto target = QSize(std::clamp(width, 236, 900), std::clamp(height, 300, 1000));
+					const auto contacts = params.value(u"surface"_q).toString() == u"contacts"_q;
+					const auto remember = contacts && params.value(u"remember"_q).toBool();
+					auto settings = QSettings(u"icqram"_q, u"icqram"_q);
+					const auto saved = settings.value(u"windows/contactsSize"_q).toSize();
+					if (saved.isValid() && ((contacts && !remember) || (!contacts && _account->sessionExists()))) target = saved.boundedTo(QSize(900, 1000)).expandedTo(QSize(236, 300));
+					resize(target);
+					if (remember) {
+						settings.setValue(u"windows/contactsSize"_q, size());
+						settings.sync();
+					}
+				}
+			} else if (method == u"window.close"_q) {
+				InvokeQueued(this, [=] { hide(); });
+			} else if (method == u"window.minimize"_q) {
+				showMinimized();
+			} else if (method == u"window.dragStart"_q) {
+				_dragOrigin = pos();
+				_dragPointer = QPoint(qRound(params.value(u"x"_q).toDouble()), qRound(params.value(u"y"_q).toDouble()));
+				_dragging = !windowHandle() || !windowHandle()->startSystemMove();
+				if (!_dragging) {
+					LOG(("icqram system window drag: moved=%1").arg(pos() != _dragOrigin));
+				}
+			} else if (method == u"window.dragMove"_q && _dragging) {
+				move(_dragOrigin + QPoint(qRound(params.value(u"x"_q).toDouble()), qRound(params.value(u"y"_q).toDouble())) - _dragPointer);
+			} else if (method == u"window.dragEnd"_q) {
+				if (_dragging) {
+					LOG(("icqram fallback window drag: moved=%1").arg(pos() != _dragOrigin));
+				}
+				_dragging = false;
+			}
+			reply.insert(u"result"_q, QJsonObject{ { u"ok"_q, true } });
+		} else {
+			reply.insert(u"error"_q, u"CONNECTION_UNAVAILABLE"_q);
+		}
+		_webview->eval("window.icqramReceive("
+			+ QJsonDocument(reply).toJson(QJsonDocument::Compact)
+			+ ");");
+	});
+	sizeValue() | rpl::on_next([=](QSize size) {
+		if (const auto widget = _webview->widget()) {
+			widget->setGeometry(QRect(QPoint(), size));
+		}
+	}, lifetime());
+	_webview->navigate(origin + (_peerId == u"now"_q ? u"now.html"_q : u"index.html"_q));
+}
+
+void IcqramShell::finishStartup() {
+	if (!_startupActive) return;
+	_startupActive = false;
+	_startupDeadline.cancel();
+#ifdef Q_OS_MAC
+	Platform::HideIcqramStartup();
+#endif
+	focus();
+}
+
+IcqramShell::~IcqramShell() {
+#ifdef Q_OS_MAC
+	if (_startupActive) Platform::HideIcqramStartup();
+#endif
+	if (_mediaId && _mediaApi) _mediaApi->cancelMedia(_mediaId);
+}
+
+void IcqramShell::sendReply(qint64 id, QJsonObject result, QString error) {
+	auto reply = QJsonObject{{u"version"_q, 1}, {u"id"_q, id}};
+	if (error.isEmpty()) reply.insert(u"result"_q, std::move(result));
+	else reply.insert(u"error"_q, std::move(error));
+	_webview->eval("window.icqramReceive(" + QJsonDocument(reply).toJson(QJsonDocument::Compact) + ");");
+}
+
+void IcqramShell::openAuxiliary(const QString &kind, QJsonObject data) {
+	if (!IsAuxiliary(kind) || _locked || Core::App().passcodeLocked()) return;
+	auto owner = this;
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		const auto shell = dynamic_cast<IcqramShell*>(widget);
+		if (shell && shell->_peerId.isEmpty() && shell->_account == _account) { owner = shell; break; }
+	}
+	auto &panel = owner->_chats[kind];
+	if (!panel || kind == u"info"_q || (kind == u"presence"_q && !panel->isVisible())) panel = std::make_unique<IcqramShell>(nullptr, _account, _controller, kind, 0, nullptr, std::move(data));
+	panel->focus();
+}
+
+void IcqramShell::showAbout() {
+	openAuxiliary(u"about"_q);
+}
+
+bool IcqramShell::ShowMain(bool currentScreen) {
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		const auto shell = dynamic_cast<IcqramShell*>(widget);
+		if (shell && shell->_peerId.isEmpty() && !shell->_locked && !Core::App().passcodeLocked()) {
+			if (currentScreen) {
+				if (const auto screen = QGuiApplication::screenAt(QCursor::pos())) {
+					const auto area = screen->availableGeometry();
+					if (!area.contains(shell->frameGeometry())) shell->move(area.center() - shell->rect().center());
+				}
+#ifdef Q_OS_MAC
+				Platform::MoveIcqramToCurrentSpace(shell);
+#endif
+			}
+			shell->focus();
+			return true;
+		}
+	}
+	return false;
+}
+
+bool IcqramShell::ShowSettings() {
+	if (!ShowMain()) return false;
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		const auto shell = dynamic_cast<IcqramShell*>(widget);
+		if (shell && shell->_peerId.isEmpty() && !shell->_locked) {
+			shell->openAuxiliary(u"settings"_q);
+			return true;
+		}
+	}
+	return false;
+}
+
+bool IcqramShell::OpenNotificationChat(Main::Account *account, PeerId peer, MsgId topic) {
+	if (Core::App().passcodeLocked() || !account || !account->sessionExists()) return false;
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		const auto shell = dynamic_cast<IcqramShell*>(widget);
+		if (!shell || !shell->_peerId.isEmpty() || shell->_account != account || shell->_locked) continue;
+		const auto key = Api::IcqramPeerKey(peer);
+		auto &chat = shell->_chats[key];
+		if (!chat) chat = std::make_unique<IcqramShell>(nullptr, account, shell->_controller, key, 0, nullptr,
+			QJsonObject{{u"topicId"_q, int(topic.bare)}});
+		chat->focus();
+		const auto data = QJsonDocument(QJsonObject{{u"topicId"_q, int(topic.bare)}}).toJson(QJsonDocument::Compact);
+		chat->_webview->eval("window.dispatchEvent(new CustomEvent('icqram-open-notification',{detail:" + data + "}));");
+		return true;
+	}
+	return false;
+}
+
+bool IcqramShell::IsReadingChat(const Main::Account *account, PeerId peer, MsgId topic) {
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		const auto shell = dynamic_cast<IcqramShell*>(widget);
+		if (shell && shell->_account == account && shell->_chatApi && !shell->_mediaId
+			&& shell->_peerId == Api::IcqramPeerKey(peer) && !shell->_locked
+			&& shell->isVisible() && !shell->isMinimized() && shell->isActiveWindow()
+			&& shell->_chatApi->currentTopicId() == int(topic.bare)) return true;
+	}
+	return false;
+}
+
+QString IcqramShell::LocalPresence() {
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		const auto shell = dynamic_cast<IcqramShell*>(widget);
+		if (shell && shell->_peerId.isEmpty()) return shell->_presenceCode;
+	}
+	return {};
+}
+
+void IcqramShell::SetLocalPresence(const QString &code) {
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		const auto shell = dynamic_cast<IcqramShell*>(widget);
+		if (shell && shell->_peerId.isEmpty() && !shell->_locked && !Core::App().passcodeLocked() && shell->_account->sessionExists()) {
+			const auto data = QJsonDocument(QJsonObject{{u"code"_q, code}}).toJson(QJsonDocument::Compact);
+			shell->_webview->eval("document.dispatchEvent(new CustomEvent('icqram-tray-presence',{detail:" + data + "}));");
+			return;
+		}
+	}
+}
+
+void IcqramShell::HideAll() {
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		if (const auto shell = dynamic_cast<IcqramShell*>(widget)) shell->hide();
+	}
+	UpdateDockVisibility();
+}
+
+void IcqramShell::UpdateDockVisibility() {
+#ifdef Q_OS_MAC
+	auto visible = false;
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		if (const auto shell = dynamic_cast<IcqramShell*>(widget)) {
+			visible = visible || shell->isVisible() || shell->_locked;
+		}
+	}
+	Platform::SetIcqramDockVisible(visible);
+#endif
+}
+
+void IcqramShell::hideEvent(QHideEvent *event) {
+	RpWidget::hideEvent(event);
+	const auto commands = _chats.find(u"commands"_q);
+	if (commands != _chats.end()) commands->second->hide();
+	if (_mediaId && _webview) {
+		_webview->eval("window.dispatchEvent(new Event('icqram-viewer-stop'));");
+		if (_mediaApi) _mediaApi->cancelMedia(_mediaId);
+	}
+	InvokeQueued(this, [] { UpdateDockVisibility(); });
+}
+
+void IcqramShell::showEvent(QShowEvent *event) {
+	RpWidget::showEvent(event);
+	UpdateDockVisibility();
+}
+
+void IcqramShell::focus() {
+	if (_startupActive) return;
+#ifdef Q_OS_MAC
+	Platform::SetIcqramDockVisible(true);
+#endif
+	showNormal();
+	raise();
+	activateWindow();
+	_webview->focus();
+	if (_mediaId) _webview->eval("window.dispatchEvent(new Event('icqram-viewer-focus'));" );
+	if (_chatApi) _webview->eval("window.dispatchEvent(new Event('icqram-chat-changed'));");
+	if (_peerId == u"settings"_q) _webview->eval("window.dispatchEvent(new Event('icqram-settings-focus'));" );
+	if (_peerId == u"profile"_q) _webview->eval("document.dispatchEvent(new Event('icqram-refresh-profile'));");
+}
+
+void IcqramShell::setLocked(bool locked) {
+	if (_locked == locked) return;
+	if (locked) _restoreAfterLock = isVisible();
+	_locked = locked;
+	for (const auto &[id, chat] : _chats) chat->setLocked(locked);
+	if (_viewer) _viewer->setLocked(locked);
+	if (locked && _mediaId) {
+		_webview->eval("window.dispatchEvent(new Event('icqram-viewer-stop'));");
+		if (_mediaApi) _mediaApi->cancelMedia(_mediaId);
+	}
+	_webview->setInputBlocked(locked);
+	_webview->setVisible(!locked);
+	setVisible(!locked && (_peerId.isEmpty() || _restoreAfterLock));
+}
+
+} // namespace Window
